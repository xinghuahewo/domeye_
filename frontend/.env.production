VITE_API_URL=/api/v1/

# 固定开发数据档 feb-mar-2026 的可选时间范围。
# 与 config/data-profile.json 对齐：数据窗口为 [2026-02-01 00:00:00, 2026-04-01 00:00:00)。
# 这里填写的是**闭区间终点**（窗口内最后一个可选秒），前端据此推导默认范围和日期控件上下限。
# 缺失时前端会退回真实系统时间，生成窗口外的默认范围并被后端 400 拒绝。
VITE_DATA_WINDOW_START=2026-02-01T00:00:00
VITE_DATA_WINDOW_END=2026-03-31T23:59:59
