{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domeye.local/contracts/country-outage-trend-analysis-s6-v1.schema.json",
  "title": "国家中断趋势分析 S6 最终候选验收",
  "type": "object",
  "required": [
    "schema_version",
    "candidate",
    "invariance",
    "numeric_expectations",
    "core_tasks",
    "refusal_cases",
    "unfamiliar_composition_tasks",
    "value_gate",
    "surface_contract",
    "tae_matrix",
    "boundaries"
  ],
  "properties": {
    "schema_version": {"const": "country_outage_trend_analysis_s6_acceptance_v1"},
    "candidate": {
      "type": "object",
      "properties": {"production_state": {"const": "not_deployed"}},
      "required": ["base_commit", "collector_id", "product_schema_version", "evidence_graph_schema_version", "production_state"]
    },
    "invariance": {"type": "object"},
    "numeric_expectations": {"type": "object"},
    "core_tasks": {"type": "array", "minItems": 5, "maxItems": 5},
    "refusal_cases": {"type": "array", "minItems": 6},
    "unfamiliar_composition_tasks": {"type": "array", "minItems": 8},
    "value_gate": {"type": "object"},
    "surface_contract": {"type": "array", "minItems": 7, "maxItems": 7},
    "tae_matrix": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "items": {
        "type": "object",
        "required": ["id", "evidence"],
        "properties": {
          "id": {"pattern": "^TAE-(0[1-9]|1[0-5])$"},
          "evidence": {"type": "array", "minItems": 1}
        }
      }
    },
    "boundaries": {
      "type": "object",
      "properties": {
        "collector_ids": {"const": ["rrc25"]},
        "hypothesis_allowed": {"const": false},
        "causal_claim_allowed": {"const": false},
        "user_impact_claim_allowed": {"const": false},
        "external_evidence_allowed": {"const": false},
        "production_deployed": {"const": false}
      },
      "required": ["collector_ids", "control_plane_only", "hypothesis_allowed", "causal_claim_allowed", "user_impact_claim_allowed", "external_evidence_allowed", "production_deployed"]
    }
  },
  "additionalProperties": false
}
