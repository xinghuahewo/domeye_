{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domeye.local/contracts/country-outage-p2-s1/w6-independent-review.schema.json",
  "title": "P2-S1 W6 独立只读审查",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "review_id", "reviewer_identity", "reviewer_role", "read_only",
    "implemented_by_reviewer", "implementation_candidate_id", "implementation_candidate_digest",
    "review_input_digest", "question_disposition_contract_digest", "case_matrix_digest",
    "certifier_manifest_digest", "case_index_digest", "runtime_proof_digest", "performance_digest",
    "attack_digest", "findings", "blocking_findings", "overclaim_findings",
    "review_disposition", "full_question_answer_certification_passed",
    "actual_provider_model_alignment", "actual_provider_performance_acceptance", "actual_provider_cost_acceptance",
    "runtime_promotion", "production_deployed", "content_digest"
  ],
  "properties": {
    "schema_version": {"const": "country_outage_p2_s1_w6_independent_review_v2"},
    "review_id": {"type": "string", "minLength": 1},
    "reviewer_identity": {"type": "string", "minLength": 1},
    "reviewer_role": {"enum": ["product_semantic", "bgp_semantic"]},
    "read_only": {"const": true},
    "implemented_by_reviewer": {"const": false},
    "implementation_candidate_id": {"type": "string", "minLength": 1},
    "implementation_candidate_digest": {"$ref": "#/$defs/sha"},
    "review_input_digest": {"$ref": "#/$defs/sha"},
    "question_disposition_contract_digest": {"$ref": "#/$defs/sha"},
    "case_matrix_digest": {"$ref": "#/$defs/sha"},
    "certifier_manifest_digest": {"$ref": "#/$defs/sha"},
    "case_index_digest": {"$ref": "#/$defs/sha"},
    "runtime_proof_digest": {"$ref": "#/$defs/sha"},
    "performance_digest": {"$ref": "#/$defs/sha"},
    "attack_digest": {"$ref": "#/$defs/sha"},
    "findings": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "blocking_findings": {"$ref": "#/$defs/findingSet"},
    "overclaim_findings": {"$ref": "#/$defs/findingSet"},
    "review_disposition": {"enum": ["accepted_for_pre_provider_release_preparation_with_explicit_question_blocks", "revision_required"]},
    "full_question_answer_certification_passed": {"const": false},
    "actual_provider_model_alignment": {"const": false},
    "actual_provider_performance_acceptance": {"const": false},
    "actual_provider_cost_acceptance": {"const": false},
    "runtime_promotion": {"const": false},
    "production_deployed": {"const": false},
    "content_digest": {"$ref": "#/$defs/sha"}
  },
  "allOf": [
    {
      "if": {"properties": {"review_disposition": {"const": "accepted_for_pre_provider_release_preparation_with_explicit_question_blocks"}}, "required": ["review_disposition"]},
      "then": {
        "properties": {
          "blocking_findings": {"maxItems": 0},
          "overclaim_findings": {"maxItems": 0}
        }
      }
    },
    {
      "if": {"properties": {"review_disposition": {"const": "revision_required"}}, "required": ["review_disposition"]},
      "then": {
        "anyOf": [
          {"properties": {"blocking_findings": {"minItems": 1}}},
          {"properties": {"overclaim_findings": {"minItems": 1}}}
        ]
      }
    }
  ],
  "$defs": {
    "sha": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "findingSet": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
  }
}
