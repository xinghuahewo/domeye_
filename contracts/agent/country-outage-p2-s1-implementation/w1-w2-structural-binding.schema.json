{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domeye.example/contracts/agent/country-outage-p2-s1-implementation/w1-w2-structural-binding.schema.json",
  "title": "P2-S1 W1/W2 结构绑定回执合同",
  "description": "只允许 Host 闭合人口 Evidence 与 OP-10/OP-11/OP-36 输出投影的 ASN 谱系；不得执行时间、路径、集合、排名或计数业务变换。",
  "oneOf": [
    {"$ref": "#/$defs/populationEvidenceBindingReceipt"},
    {"$ref": "#/$defs/asnBoundOp11Receipt"},
    {"$ref": "#/$defs/asnBoundOp10Receipt"},
    {"$ref": "#/$defs/asnBoundOp36Receipt"}
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "asn": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "evidenceRef": {
      "type": "object",
      "required": ["evidence_id", "source_digest", "member_key"],
      "properties": {
        "evidence_id": {"type": "string", "minLength": 1},
        "source_digest": {"$ref": "#/$defs/digest"},
        "member_key": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "validatorIdentity": {
      "type": "object",
      "required": ["validator_id", "validator_version", "contract_digest", "implementation_digest"],
      "properties": {
        "validator_id": {"const": "country_outage_p2_s1_structural_binding_validator"},
        "validator_version": {"const": "1.0.0"},
        "contract_digest": {"$ref": "#/$defs/digest"},
        "implementation_digest": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": false
    },
    "sourcePopulationRef": {
      "type": "object",
      "required": [
        "source_kind",
        "artifact_id",
        "artifact_revision",
        "population_id",
        "content_digest",
        "manifest_digest",
        "completeness_receipt_digest"
      ],
      "properties": {
        "source_kind": {
          "type": "string",
          "enum": ["frozen_result_set", "operator_output_population"]
        },
        "artifact_id": {"type": "string", "minLength": 1},
        "artifact_revision": {"type": "integer", "minimum": 1},
        "population_id": {"type": "string", "minLength": 1},
        "content_digest": {"$ref": "#/$defs/digest"},
        "manifest_digest": {"$ref": "#/$defs/digest"},
        "completeness_receipt_digest": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": false
    },
    "populationEvidenceBindingReceipt": {
      "type": "object",
      "required": [
        "schema_version",
        "receipt_kind",
        "design_candidate_id",
        "operator_id",
        "operator_input_name",
        "operator_input_digest",
        "source_population_ref",
        "set_completeness",
        "member_count",
        "member_keys_digest",
        "population_evidence_ref",
        "validator",
        "business_transform_count",
        "receipt_digest"
      ],
      "properties": {
        "schema_version": {"const": "country_outage_p2_s1_population_evidence_binding_receipt_v1"},
        "receipt_kind": {"const": "population_evidence_binding"},
        "design_candidate_id": {"const": "country-outage-p2-s1-s1d-6-04135cee55b39ce5d574f7e4"},
        "operator_id": {
          "type": "string",
          "enum": [
            "OP-06", "OP-07", "OP-08", "OP-09", "OP-11", "OP-12", "OP-13", "OP-14",
            "OP-18", "OP-20", "OP-21",
            "OP-22", "OP-23", "OP-24", "OP-25", "OP-26", "OP-27", "OP-28", "OP-33", "OP-35", "OP-36"
          ]
        },
        "operator_input_name": {
          "type": "string",
          "enum": [
            "ordered_state_points", "ordered_numeric_points", "intervals", "crossing_receipts",
            "longest_interval_receipts", "ratio_receipts", "path_evidence_members", "members", "left_set", "right_set",
            "new_prefix_state_rows", "route_state_rows"
          ]
        },
        "operator_input_digest": {"$ref": "#/$defs/digest"},
        "identity_digest": {"$ref": "#/$defs/digest"},
        "source_population_ref": {"$ref": "#/$defs/sourcePopulationRef"},
        "set_completeness": {"const": "complete"},
        "member_count": {"type": "integer", "minimum": 0},
        "member_keys_digest": {"$ref": "#/$defs/digest"},
        "population_evidence_ref": {"$ref": "#/$defs/evidenceRef"},
        "validator": {"$ref": "#/$defs/validatorIdentity"},
        "business_transform_count": {"const": 0},
        "receipt_digest": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {"operator_id": {"const": "OP-33"}},
            "required": ["operator_id"]
          },
          "then": {"required": ["identity_digest"]}
        }
      ],
      "x-runtime-invariants": [
        "receipt_digest 等于排除自身后的规范 JSON SHA-256",
        "operator_input_digest 等于对应完整输入人口的规范摘要",
        "member_count 与输入人口成员数精确相等，空人口必须为 0",
        "population_evidence_ref.source_digest 等于 source_population_ref.completeness_receipt_digest",
        "OP-33 的左右人口回执必须分别绑定同一 Operator identity_digest，空人口不得豁免",
        "Host 必须从受信内容寻址 Store 解析 source_population_ref，不接受调用方自报",
        "该回执只提供 Evidence 谱系，不得过滤、排序、聚合或构造成员"
      ]
    },
    "sourcePlanBinding": {
      "type": "object",
      "required": [
        "source_plan_id", "source_plan_revision", "source_plan_node_id",
        "source_node_result_digest", "source_asn_binding_digest"
      ],
      "properties": {
        "source_plan_id": {"type": "string", "minLength": 1},
        "source_plan_revision": {"type": "integer", "minimum": 1},
        "source_plan_node_id": {"type": "string", "minLength": 1},
        "source_node_result_digest": {"$ref": "#/$defs/digest"},
        "source_asn_binding_digest": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": false
    },
    "asnBoundOp11Receipt": {
      "type": "object",
      "required": [
        "schema_version",
        "receipt_kind",
        "design_candidate_id",
        "target_operator_id",
        "asn",
        "op11_output_digest",
        "op11_input_digest",
        "source_plan_id",
        "source_plan_revision",
        "source_plan_node_id",
        "source_node_result_digest",
        "source_asn_binding_digest",
        "evidence_refs",
        "validator",
        "business_transform_count",
        "receipt_digest"
      ],
      "properties": {
        "schema_version": {"const": "country_outage_p2_s1_asn_bound_op11_receipt_v1"},
        "receipt_kind": {"const": "asn_bound_op11_receipt"},
        "design_candidate_id": {"const": "country-outage-p2-s1-s1d-6-04135cee55b39ce5d574f7e4"},
        "target_operator_id": {"const": "OP-13"},
        "asn": {"$ref": "#/$defs/asn"},
        "op11_output_digest": {"$ref": "#/$defs/digest"},
        "op11_input_digest": {"$ref": "#/$defs/digest"},
        "source_plan_id": {"type": "string", "minLength": 1},
        "source_plan_revision": {"type": "integer", "minimum": 1},
        "source_plan_node_id": {"type": "string", "minLength": 1},
        "source_node_result_digest": {"$ref": "#/$defs/digest"},
        "source_asn_binding_digest": {"$ref": "#/$defs/digest"},
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidenceRef"}
        },
        "validator": {"$ref": "#/$defs/validatorIdentity"},
        "business_transform_count": {"const": 0},
        "receipt_digest": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": false,
      "x-runtime-invariants": [
        "receipt_digest 等于排除自身后的规范 JSON SHA-256",
        "op11_output_digest 必须解析到同一 identity 的完整 OP-11 输出回执",
        "source_node_result_digest 必须等于该 source_plan_node_id 的已提交结果摘要",
        "source_asn_binding_digest 必须解析到该节点冻结输入中的 ASN 字段投影",
        "同一次 OP-13 调用中每个 op11_output_digest 恰有一个 ASN 绑定且不得重复",
        "Host 不得读取或计算 duration_seconds；OP-13 仍是唯一执行时长排名的业务单元"
      ]
    },
    "asnBoundOp10Receipt": {
      "type": "object",
      "required": [
        "schema_version", "receipt_kind", "design_candidate_id", "target_operator_id", "asn",
        "op10_output_digest", "op10_input_digest", "source_plan_id", "source_plan_revision",
        "source_plan_node_id", "source_node_result_digest", "source_asn_binding_digest",
        "evidence_refs", "validator", "business_transform_count", "receipt_digest"
      ],
      "properties": {
        "schema_version": {"const": "country_outage_p2_s1_asn_bound_op10_receipt_v1"},
        "receipt_kind": {"const": "asn_bound_op10_receipt"},
        "design_candidate_id": {"const": "country-outage-p2-s1-s1d-6-04135cee55b39ce5d574f7e4"},
        "target_operator_id": {"const": "OP-14"},
        "asn": {"$ref": "#/$defs/asn"},
        "op10_output_digest": {"$ref": "#/$defs/digest"},
        "op10_input_digest": {"$ref": "#/$defs/digest"},
        "source_plan_id": {"type": "string", "minLength": 1},
        "source_plan_revision": {"type": "integer", "minimum": 1},
        "source_plan_node_id": {"type": "string", "minLength": 1},
        "source_node_result_digest": {"$ref": "#/$defs/digest"},
        "source_asn_binding_digest": {"$ref": "#/$defs/digest"},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidenceRef"}},
        "validator": {"$ref": "#/$defs/validatorIdentity"},
        "business_transform_count": {"const": 0},
        "receipt_digest": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": false,
      "x-runtime-invariants": [
        "receipt_digest 等于排除自身后的规范 JSON SHA-256",
        "op10_output_digest 必须解析到同一 identity 的完整 OP-10 OutputEnvelope",
        "冻结 op10Receipt 投影视图的 result 五字段必须等于完整输出的同名投影",
        "asn 必须等于完整 OP-10 输出中的 ASN 且绑定来源 Plan 节点",
        "Host 不得计算比例或排名，business_transform_count 固定为 0"
      ]
    },
    "asnBoundOp36Receipt": {
      "type": "object",
      "required": [
        "schema_version", "receipt_kind", "design_candidate_id", "target_operator_id", "asn",
        "op36_output_digest", "op36_input_digest", "source_plan_id", "source_plan_revision",
        "source_plan_node_id", "source_node_result_digest", "source_asn_binding_digest",
        "evidence_refs", "validator", "business_transform_count", "receipt_digest"
      ],
      "properties": {
        "schema_version": {"const": "country_outage_p2_s1_asn_bound_op36_receipt_v1"},
        "receipt_kind": {"const": "asn_bound_op36_receipt"},
        "design_candidate_id": {"const": "country-outage-p2-s1-s1d-6-04135cee55b39ce5d574f7e4"},
        "target_operator_id": {"const": "OP-12"},
        "asn": {"$ref": "#/$defs/asn"},
        "op36_output_digest": {"$ref": "#/$defs/digest"},
        "op36_input_digest": {"$ref": "#/$defs/digest"},
        "source_plan_id": {"type": "string", "minLength": 1},
        "source_plan_revision": {"type": "integer", "minimum": 1},
        "source_plan_node_id": {"type": "string", "minLength": 1},
        "source_node_result_digest": {"$ref": "#/$defs/digest"},
        "source_asn_binding_digest": {"$ref": "#/$defs/digest"},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidenceRef"}},
        "validator": {"$ref": "#/$defs/validatorIdentity"},
        "business_transform_count": {"const": 0},
        "receipt_digest": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": false,
      "x-runtime-invariants": [
        "receipt_digest 等于排除自身后的规范 JSON SHA-256",
        "op36_output_digest 必须解析到同一 identity 的完整 OP-36 OutputEnvelope",
        "冻结 op36Receipt 投影视图的状态、时间、Profile、输入和输出摘要必须等于完整输出投影",
        "asn 必须来自绑定来源 Plan 节点，不能由调用方自由填入",
        "Host 不得检测穿越或排名，business_transform_count 固定为 0"
      ]
    }
  }
}
