{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domeye.example/contracts/agent/country-outage-p2-s1-implementation/w0-trusted-receipt.schema.json",
  "title": "P2-S1 Host可信回执信封",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_type", "receipt_digest", "candidate_id", "publication_identity", "subject", "issued_at_utc", "payload_digest", "payload"],
  "properties": {
    "schema_version": {"const": "country_outage_p2_s1_trusted_receipt_v1"},
    "receipt_type": {"enum": ["source_materialization", "source_manifest", "registry_proposal_admission", "registry_activation", "tool_query", "operator_execution", "investigation_commit"]},
    "receipt_digest": {"$ref": "#/$defs/digest"},
    "candidate_id": {"type": "string", "minLength": 1},
    "publication_identity": {"$ref": "#/$defs/publicationIdentity"},
    "subject": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "id", "version", "content_digest"],
      "properties": {
        "kind": {"enum": ["source_view", "registry_snapshot", "execution_unit", "investigation"]},
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "content_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "issued_at_utc": {"type": "string", "format": "date-time"},
    "payload_digest": {"$ref": "#/$defs/digest"},
    "payload": {"type": "object"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "publicationIdentity": {
      "type": "object", "additionalProperties": false,
      "required": ["event_type", "incident_id", "publication_id", "revision", "cohort_id", "collector_id", "window_start_utc", "window_end_utc", "data_through_utc"],
      "properties": {
        "event_type": {"const": "country_outage"}, "incident_id": {"type": "string", "minLength": 1}, "publication_id": {"type": "string", "minLength": 1},
        "revision": {"type": "integer", "minimum": 1}, "cohort_id": {"type": "string", "minLength": 1}, "collector_id": {"const": "rrc25"},
        "window_start_utc": {"type": "string", "format": "date-time"}, "window_end_utc": {"type": "string", "format": "date-time"}, "data_through_utc": {"type": "string", "format": "date-time"}
      }
    }
  },
  "x-digest-contract": "receipt_digest=sha256(p2-s1-canonical-json-v1(receipt excluding receipt_digest)); payload_digest同理绑定payload",
  "x-store-boundary": "只有Host验证器可创建并写入；caller只提交业务请求，不能提交可信回执"
}
