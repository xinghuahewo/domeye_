{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domeye.example/contracts/agent/country-outage-p2-s1-implementation/w1-w2-tool-runtime.schema.json",
  "title": "RRC25 国家中断 P2-S1 W1/W2 原子 Tool 运行时合同",
  "description": "冻结 TOOL-07/08/09/10/12 的实际请求、ResultSet page 与失败 envelope。该合同不授权 API、跨页冻结、导出或运行时激活。",
  "type": "object",
  "required": ["schema_version", "contract_scope"],
  "properties": {
    "schema_version": {"const": "country_outage_p2_s1_w1_w2_tool_runtime_contract_v1"},
    "contract_scope": {"const": "offline_atomic_tool_harness_only"}
  },
  "additionalProperties": false,
  "$defs": {
    "hex64": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nonEmptyString": {"type": "string", "minLength": 1},
    "asn": {"type": "integer", "minimum": 0, "maximum": 4294967295},
    "afi": {"enum": [4, 6]},
    "sourceAfi": {"enum": ["ipv4", "ipv6"]},
    "utc": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "identity": {
      "type": "object",
      "required": [
        "incident_id", "publication_id", "publication_revision", "publication_digest",
        "collector_id", "cohort_id", "cohort_digest", "window_start_utc", "window_end_utc",
        "data_through_utc", "finality", "registry_snapshot_id", "registry_snapshot_digest",
        "binding_generation"
      ],
      "properties": {
        "incident_id": {"$ref": "#/$defs/nonEmptyString"},
        "publication_id": {"$ref": "#/$defs/nonEmptyString"},
        "publication_revision": {"type": "integer", "minimum": 1},
        "publication_digest": {"$ref": "#/$defs/hex64"},
        "collector_id": {"const": "rrc25"},
        "cohort_id": {"$ref": "#/$defs/nonEmptyString"},
        "cohort_digest": {"$ref": "#/$defs/hex64"},
        "window_start_utc": {"$ref": "#/$defs/utc"},
        "window_end_utc": {"$ref": "#/$defs/utc"},
        "data_through_utc": {"$ref": "#/$defs/utc"},
        "finality": {"enum": ["event_end_unknown", "event_end_known"]},
        "registry_snapshot_id": {"$ref": "#/$defs/nonEmptyString"},
        "registry_snapshot_digest": {"$ref": "#/$defs/hex64"},
        "binding_generation": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "timeRangeHalfOpen": {
      "type": "object",
      "required": ["start_utc", "end_utc"],
      "properties": {
        "start_utc": {"$ref": "#/$defs/utc"},
        "end_utc": {"$ref": "#/$defs/utc"}
      },
      "additionalProperties": false
    },
    "requestBaseProperties": {
      "type": "object",
      "properties": {
        "identity": {"$ref": "#/$defs/identity"},
        "page_size": {"type": "integer", "minimum": 1, "maximum": 2000},
        "page_token": {"type": ["string", "null"]}
      }
    },
    "tool07Request": {
      "type": "object",
      "required": ["identity", "page_size"],
      "properties": {
        "identity": {"$ref": "#/$defs/identity"},
        "page_size": {"type": "integer", "minimum": 1, "maximum": 1000},
        "page_token": {"type": ["string", "null"]},
        "asn": {"$ref": "#/$defs/asn"},
        "prefix": {"$ref": "#/$defs/nonEmptyString"},
        "afi": {"$ref": "#/$defs/afi"}
      },
      "additionalProperties": false
    },
    "tool08Request": {
      "type": "object",
      "required": ["identity", "page_size"],
      "properties": {
        "identity": {"$ref": "#/$defs/identity"},
        "page_size": {"type": "integer", "minimum": 1, "maximum": 2000},
        "page_token": {"type": ["string", "null"]},
        "prefix": {"$ref": "#/$defs/nonEmptyString"},
        "afi": {"$ref": "#/$defs/afi"},
        "state_point_utc": {"$ref": "#/$defs/utc"},
        "time_range_half_open": {"$ref": "#/$defs/timeRangeHalfOpen"},
        "classification": {"enum": ["normal", "partial", "complete", "unknown"]}
      },
      "not": {"required": ["state_point_utc", "time_range_half_open"]},
      "additionalProperties": false
    },
    "tool09Request": {
      "type": "object",
      "required": ["identity", "page_size"],
      "properties": {
        "identity": {"$ref": "#/$defs/identity"},
        "page_size": {"type": "integer", "minimum": 1, "maximum": 2000},
        "page_token": {"type": ["string", "null"]},
        "asn": {"$ref": "#/$defs/asn"},
        "state_point_utc": {"$ref": "#/$defs/utc"},
        "time_range_half_open": {"$ref": "#/$defs/timeRangeHalfOpen"},
        "classification": {"enum": ["normal", "affected", "route_interrupted", "unknown"]}
      },
      "not": {"required": ["state_point_utc", "time_range_half_open"]},
      "additionalProperties": false
    },
    "tool10Request": {
      "type": "object",
      "required": ["identity", "page_size"],
      "properties": {
        "identity": {"$ref": "#/$defs/identity"},
        "page_size": {"type": "integer", "minimum": 1, "maximum": 2000},
        "page_token": {"type": ["string", "null"]},
        "prefix": {"$ref": "#/$defs/nonEmptyString"},
        "afi": {"$ref": "#/$defs/afi"},
        "first_observed_range_half_open": {"$ref": "#/$defs/timeRangeHalfOpen"},
        "state_point_utc": {"$ref": "#/$defs/utc"},
        "time_range_half_open": {"$ref": "#/$defs/timeRangeHalfOpen"},
        "classification": {"enum": ["normal", "partial", "complete", "unknown"]}
      },
      "not": {"required": ["state_point_utc", "time_range_half_open"]},
      "additionalProperties": false
    },
    "tool12Request": {
      "type": "object",
      "required": ["identity", "page_size"],
      "properties": {
        "identity": {"$ref": "#/$defs/identity"},
        "page_size": {"type": "integer", "minimum": 1, "maximum": 1000},
        "page_token": {"type": ["string", "null"]},
        "anchor_asn": {"$ref": "#/$defs/asn"},
        "known_origin_asn": {"$ref": "#/$defs/asn"},
        "anchor_before_known_origin": {"const": true},
        "contains_asn": {"$ref": "#/$defs/asn"},
        "prefix": {"$ref": "#/$defs/nonEmptyString"},
        "afi": {"$ref": "#/$defs/afi"},
        "path_id": {"$ref": "#/$defs/nonEmptyString"},
        "peer_asn_direction_id": {"$ref": "#/$defs/nonEmptyString"},
        "ordered_sequence_eligible": {"type": "boolean"}
      },
      "dependentRequired": {"anchor_before_known_origin": ["anchor_asn"]},
      "additionalProperties": false
    },
    "toolRequest": {
      "oneOf": [
        {"$ref": "#/$defs/tool07Request"},
        {"$ref": "#/$defs/tool08Request"},
        {"$ref": "#/$defs/tool09Request"},
        {"$ref": "#/$defs/tool10Request"},
        {"$ref": "#/$defs/tool12Request"}
      ]
    },
    "evidenceRef": {
      "type": "object",
      "required": ["evidence_id", "source_digest", "member_key"],
      "properties": {
        "evidence_id": {"$ref": "#/$defs/nonEmptyString"},
        "source_digest": {"$ref": "#/$defs/hex64"},
        "member_key": {"$ref": "#/$defs/nonEmptyString"}
      },
      "additionalProperties": false
    },
    "pathSegment": {
      "type": "object",
      "required": ["segment_type", "asns"],
      "properties": {
        "segment_type": {"enum": ["as_sequence", "as_set", "confederation_sequence", "confederation_set"]},
        "asns": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/asn"}}
      },
      "additionalProperties": false
    },
    "tool07Member": {
      "type": "object",
      "required": ["cohort_member_id", "prefix", "afi", "country_origin_asns", "expected_peer_asn_direction_ids", "expected_route_observation_keys", "membership_basis", "evidence_ref"],
      "properties": {
        "cohort_member_id": {"$ref": "#/$defs/nonEmptyString"},
        "prefix": {"$ref": "#/$defs/nonEmptyString"},
        "afi": {"$ref": "#/$defs/afi"},
        "country_origin_asns": {"type": "array", "items": {"$ref": "#/$defs/asn"}},
        "expected_peer_asn_direction_ids": {"type": "array", "items": {"$ref": "#/$defs/nonEmptyString"}},
        "expected_route_observation_keys": {"type": "array", "items": {"$ref": "#/$defs/nonEmptyString"}},
        "membership_basis": {"$ref": "#/$defs/nonEmptyString"},
        "evidence_ref": {"$ref": "#/$defs/evidenceRef"}
      },
      "additionalProperties": false
    },
    "tool08Member": {
      "type": "object",
      "required": ["state_point_utc", "prefix", "afi", "classification", "expected_direction_count", "visible_direction_count", "invisible_direction_count", "unknown_direction_count", "evidence_ref"],
      "properties": {
        "state_point_utc": {"$ref": "#/$defs/utc"},
        "prefix": {"$ref": "#/$defs/nonEmptyString"},
        "afi": {"$ref": "#/$defs/afi"},
        "classification": {"enum": ["normal", "partial", "complete", "unknown"]},
        "expected_direction_count": {"type": "integer", "minimum": 0},
        "visible_direction_count": {"type": "integer", "minimum": 0},
        "invisible_direction_count": {"type": "integer", "minimum": 0},
        "unknown_direction_count": {"type": "integer", "minimum": 0},
        "evidence_ref": {"$ref": "#/$defs/evidenceRef"}
      },
      "additionalProperties": false
    },
    "tool09Member": {
      "type": "object",
      "required": ["state_point_utc", "asn", "classification", "fixed_prefix_count", "partial_prefix_count", "complete_prefix_count", "unknown_prefix_count", "invisible_direction_count", "evidence_ref"],
      "properties": {
        "state_point_utc": {"$ref": "#/$defs/utc"},
        "asn": {"$ref": "#/$defs/asn"},
        "classification": {"enum": ["normal", "affected", "route_interrupted", "unknown"]},
        "fixed_prefix_count": {"type": "integer", "minimum": 0},
        "partial_prefix_count": {"type": "integer", "minimum": 0},
        "complete_prefix_count": {"type": "integer", "minimum": 0},
        "unknown_prefix_count": {"type": "integer", "minimum": 0},
        "invisible_direction_count": {"type": "integer", "minimum": 0},
        "evidence_ref": {"$ref": "#/$defs/evidenceRef"}
      },
      "additionalProperties": false
    },
    "tool10Member": {
      "type": "object",
      "required": ["new_prefix_state_id", "prefix", "afi", "first_observed_at_utc", "state_point_utc", "classification", "evidence_ref"],
      "properties": {
        "new_prefix_state_id": {"$ref": "#/$defs/nonEmptyString"},
        "prefix": {"$ref": "#/$defs/nonEmptyString"},
        "afi": {"$ref": "#/$defs/afi"},
        "first_observed_at_utc": {"$ref": "#/$defs/utc"},
        "state_point_utc": {"$ref": "#/$defs/utc"},
        "classification": {"enum": ["normal", "partial", "complete", "unknown"]},
        "evidence_ref": {"$ref": "#/$defs/evidenceRef"}
      },
      "additionalProperties": false
    },
    "tool12Member": {
      "type": "object",
      "required": ["path_association_id", "anchor_asn", "known_origin_asn", "origin_status", "observed_origin_asn", "prefix", "afi", "path_id", "path_digest", "path_canonicalization_profile_id", "path_canonicalization_profile_digest", "path_segments", "path_parse_status", "common_path_status", "ordered_sequence_eligible", "peer_asn_direction_ids", "route_observation_count", "evidence_ref"],
      "properties": {
        "path_association_id": {"$ref": "#/$defs/nonEmptyString"},
        "anchor_asn": {"$ref": "#/$defs/asn"},
        "known_origin_asn": {"$ref": "#/$defs/asn"},
        "origin_status": {"const": "known"},
        "observed_origin_asn": {"$ref": "#/$defs/asn"},
        "prefix": {"$ref": "#/$defs/nonEmptyString"},
        "afi": {"$ref": "#/$defs/afi"},
        "path_id": {"$ref": "#/$defs/nonEmptyString"},
        "path_digest": {"$ref": "#/$defs/hex64"},
        "path_canonicalization_profile_id": {"$ref": "#/$defs/nonEmptyString"},
        "path_canonicalization_profile_digest": {"$ref": "#/$defs/hex64"},
        "path_segments": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/pathSegment"}},
        "path_parse_status": {"const": "ordered"},
        "common_path_status": {"const": "ordered"},
        "ordered_sequence_eligible": {"const": true},
        "peer_asn_direction_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonEmptyString"}},
        "route_observation_count": {"type": "integer", "minimum": 0},
        "evidence_ref": {"$ref": "#/$defs/evidenceRef"}
      },
      "additionalProperties": false
    },
    "sourcePopulationBinding": {
      "type": "object",
      "required": ["materialized_row_count", "source_population_complete", "source_population_content_digest", "source_population_freeze_digest", "source_population_manifest_digest", "source_population_projection_cardinality", "source_population_record_refs", "source_population_row_count", "source_population_rows_digest", "source_population_source_ref"],
      "properties": {
        "materialized_row_count": {"type": "integer", "minimum": 0},
        "source_population_complete": {"const": true},
        "source_population_content_digest": {"$ref": "#/$defs/hex64"},
        "source_population_freeze_digest": {"$ref": "#/$defs/hex64"},
        "source_population_manifest_digest": {"$ref": "#/$defs/hex64"},
        "source_population_projection_cardinality": {"enum": ["one_to_one", "one_to_many_materialized_projection"]},
        "source_population_record_refs": {"type": "array", "items": {"$ref": "#/$defs/nonEmptyString"}},
        "source_population_row_count": {"type": "integer", "minimum": 0},
        "source_population_rows_digest": {"$ref": "#/$defs/hex64"},
        "source_population_source_ref": {"$ref": "#/$defs/nonEmptyString"}
      },
      "additionalProperties": false
    },
    "normalizedFilters": {
      "type": "object",
      "properties": {
        "asn": {"$ref": "#/$defs/asn"},
        "anchor_asn": {"$ref": "#/$defs/asn"},
        "known_origin_asn": {"$ref": "#/$defs/asn"},
        "anchor_before_known_origin": {"const": true},
        "contains_asn": {"$ref": "#/$defs/asn"},
        "prefix": {"$ref": "#/$defs/nonEmptyString"},
        "afi": {"$ref": "#/$defs/afi"},
        "state_point_utc": {"$ref": "#/$defs/utc"},
        "time_range_half_open": {"$ref": "#/$defs/timeRangeHalfOpen"},
        "first_observed_range_half_open": {"$ref": "#/$defs/timeRangeHalfOpen"},
        "classification": {"$ref": "#/$defs/nonEmptyString"},
        "path_id": {"$ref": "#/$defs/nonEmptyString"},
        "peer_asn_direction_id": {"$ref": "#/$defs/nonEmptyString"},
        "ordered_sequence_eligible": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "normalizedQuery": {
      "type": "object",
      "required": ["filters"],
      "properties": {"filters": {"$ref": "#/$defs/normalizedFilters"}},
      "additionalProperties": false
    },
    "queryReceipt": {
      "type": "object",
      "required": ["schema_version", "tool_id", "tool_version", "publication_id", "identity_digest", "normalized_query", "query_digest", "stable_sort_digest", "source_store_id", "source_store_content_sha256", "source_population_id", "source_dataset_digest", "source_schema_ref", "source_schema_digest", "source_index_digest", "source_materialization_receipt_digest", "source_population_binding", "path_association_index_digest", "path_association_materialization_receipt_digest", "filter_mode", "source_completeness", "complete_claim_label", "matched_member_keys_digest", "matched_total_count", "page_member_keys_digest", "page_returned_count", "page_offset", "next_offset", "disposition", "receipt_digest", "receipt_auth_tag"],
      "properties": {
        "schema_version": {"const": "country_outage_p2_s1_query_receipt_v1"},
        "tool_id": {"enum": ["TOOL-07", "TOOL-08", "TOOL-09", "TOOL-10", "TOOL-12"]},
        "tool_version": {"const": "1.0.0"},
        "publication_id": {"$ref": "#/$defs/nonEmptyString"},
        "identity_digest": {"$ref": "#/$defs/hex64"},
        "normalized_query": {"$ref": "#/$defs/normalizedQuery"},
        "query_digest": {"$ref": "#/$defs/hex64"},
        "stable_sort_digest": {"$ref": "#/$defs/hex64"},
        "source_store_id": {"$ref": "#/$defs/nonEmptyString"},
        "source_store_content_sha256": {"$ref": "#/$defs/hex64"},
        "source_population_id": {"$ref": "#/$defs/nonEmptyString"},
        "source_dataset_digest": {"$ref": "#/$defs/hex64"},
        "source_schema_ref": {"$ref": "#/$defs/nonEmptyString"},
        "source_schema_digest": {"$ref": "#/$defs/hex64"},
        "source_index_digest": {"$ref": "#/$defs/hex64"},
        "source_materialization_receipt_digest": {"$ref": "#/$defs/hex64"},
        "source_population_binding": {"$ref": "#/$defs/sourcePopulationBinding"},
        "path_association_index_digest": {"anyOf": [{"$ref": "#/$defs/hex64"}, {"type": "null"}]},
        "path_association_materialization_receipt_digest": {"anyOf": [{"$ref": "#/$defs/hex64"}, {"type": "null"}]},
        "filter_mode": {"enum": ["verified_single_population_predicate_scan", "pre_materialized_native_index"]},
        "source_completeness": {"const": "complete"},
        "complete_claim_label": {"$ref": "#/$defs/nonEmptyString"},
        "matched_member_keys_digest": {"$ref": "#/$defs/hex64"},
        "matched_total_count": {"type": "integer", "minimum": 0},
        "page_member_keys_digest": {"$ref": "#/$defs/hex64"},
        "page_returned_count": {"type": "integer", "minimum": 0},
        "page_offset": {"type": "integer", "minimum": 0},
        "next_offset": {"type": ["integer", "null"], "minimum": 0},
        "disposition": {"enum": ["matched_population", "complete_empty", "unsupported_noneligible_anchor"]},
        "receipt_digest": {"$ref": "#/$defs/hex64"},
        "receipt_auth_tag": {"$ref": "#/$defs/hex64"},
        "native_filter_applied": {"type": "boolean"},
        "filter_profile_id": {"$ref": "#/$defs/nonEmptyString"},
        "filter_profile_digest": {"$ref": "#/$defs/hex64"},
        "path_asn_membership_index_id": {"$ref": "#/$defs/nonEmptyString"},
        "anchor_before_known_origin_index_id": {"$ref": "#/$defs/nonEmptyString"},
        "anchor_population_source_ref": {"$ref": "#/$defs/nonEmptyString"},
        "anchor_population_manifest_digest": {"$ref": "#/$defs/hex64"},
        "anchor_population_content_digest": {"$ref": "#/$defs/hex64"},
        "anchor_population_freeze_digest": {"$ref": "#/$defs/hex64"},
        "eligible_anchor_asns_digest": {"$ref": "#/$defs/hex64"},
        "eligible_anchor_asn_count": {"type": "integer", "minimum": 0},
        "association_population_source_ref": {"$ref": "#/$defs/nonEmptyString"},
        "association_manifest_digest": {"$ref": "#/$defs/hex64"},
        "association_content_digest": {"$ref": "#/$defs/hex64"},
        "association_freeze_digest": {"$ref": "#/$defs/hex64"},
        "association_source_row_count": {"type": "integer", "minimum": 0},
        "association_source_rows_digest": {"$ref": "#/$defs/hex64"},
        "association_population_complete": {"const": true},
        "target_contains_asn": {"anyOf": [{"$ref": "#/$defs/asn"}, {"type": "null"}]},
        "target_anchor_asn": {"anyOf": [{"$ref": "#/$defs/asn"}, {"type": "null"}]},
        "anchor_before_known_origin": {"type": ["boolean", "null"]},
        "anchor_population_eligible": {"type": ["boolean", "null"]},
        "source_row_invariants": {"type": "array", "items": {"$ref": "#/$defs/nonEmptyString"}}
      },
      "additionalProperties": false
    },
    "toolResultPage": {
      "type": "object",
      "required": ["result_set_id", "tool_run_id", "tool_id", "tool_version", "query_digest", "identity_digest", "source_population_id", "source_dataset_digest", "normalized_query", "stable_sort", "stable_sort_digest", "members", "returned_count", "total_count", "page_complete", "page_offset", "set_completeness", "next_page_token", "query_receipt", "query_receipt_digest", "evidence_refs", "limitations", "content_digest"],
      "properties": {
        "result_set_id": {"type": "string", "pattern": "^result-set-sha256:[0-9a-f]{64}$"},
        "tool_run_id": {"type": "string", "pattern": "^tool-run-sha256:[0-9a-f]{64}$"},
        "tool_id": {"enum": ["TOOL-07", "TOOL-08", "TOOL-09", "TOOL-10", "TOOL-12"]},
        "tool_version": {"const": "1.0.0"},
        "query_digest": {"$ref": "#/$defs/hex64"},
        "identity_digest": {"$ref": "#/$defs/hex64"},
        "source_population_id": {"$ref": "#/$defs/nonEmptyString"},
        "source_dataset_digest": {"$ref": "#/$defs/hex64"},
        "normalized_query": {"$ref": "#/$defs/normalizedQuery"},
        "stable_sort": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonEmptyString"}},
        "stable_sort_digest": {"$ref": "#/$defs/hex64"},
        "members": {"type": "array", "items": {"oneOf": [{"$ref": "#/$defs/tool07Member"}, {"$ref": "#/$defs/tool08Member"}, {"$ref": "#/$defs/tool09Member"}, {"$ref": "#/$defs/tool10Member"}, {"$ref": "#/$defs/tool12Member"}]}},
        "returned_count": {"type": "integer", "minimum": 0},
        "total_count": {"type": "integer", "minimum": 0},
        "page_complete": {"const": true},
        "page_offset": {"type": "integer", "minimum": 0},
        "set_completeness": {"enum": ["complete", "partial_page"]},
        "next_page_token": {"type": ["string", "null"]},
        "query_receipt": {"$ref": "#/$defs/queryReceipt"},
        "query_receipt_digest": {"$ref": "#/$defs/hex64"},
        "evidence_refs": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/nonEmptyString"}},
        "limitations": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/nonEmptyString"}},
        "content_digest": {"$ref": "#/$defs/hex64"}
      },
      "additionalProperties": false
    },
    "tool07ResultPage": {
      "allOf": [
        {"$ref": "#/$defs/toolResultPage"},
        {
          "properties": {
            "tool_id": {"const": "TOOL-07"},
            "source_population_id": {"const": "fixed_cohort_member_rows"},
            "members": {"type": "array", "items": {"$ref": "#/$defs/tool07Member"}},
            "query_receipt": {
              "allOf": [
                {"$ref": "#/$defs/queryReceipt"},
                {"properties": {"tool_id": {"const": "TOOL-07"}}}
              ]
            }
          }
        }
      ]
    },
    "tool08ResultPage": {
      "allOf": [
        {"$ref": "#/$defs/toolResultPage"},
        {
          "properties": {
            "tool_id": {"const": "TOOL-08"},
            "source_population_id": {"const": "prefix_state_rows"},
            "members": {"type": "array", "items": {"$ref": "#/$defs/tool08Member"}},
            "query_receipt": {
              "allOf": [
                {"$ref": "#/$defs/queryReceipt"},
                {"properties": {"tool_id": {"const": "TOOL-08"}}}
              ]
            }
          }
        }
      ]
    },
    "tool09ResultPage": {
      "allOf": [
        {"$ref": "#/$defs/toolResultPage"},
        {
          "properties": {
            "tool_id": {"const": "TOOL-09"},
            "source_population_id": {"const": "asn_state_rows"},
            "members": {"type": "array", "items": {"$ref": "#/$defs/tool09Member"}},
            "query_receipt": {
              "allOf": [
                {"$ref": "#/$defs/queryReceipt"},
                {"properties": {"tool_id": {"const": "TOOL-09"}}}
              ]
            }
          }
