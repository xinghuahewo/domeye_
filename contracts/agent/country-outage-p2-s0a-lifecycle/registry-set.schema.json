{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domeye.local/contracts/country-outage-p2-s0a-registry-set-v1.schema.json",
  "title": "国家中断 Agent P2-S0A 双 Registry 合同",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_id",
    "registry_revision",
    "activation_scope",
    "runtime_integration",
    "capability_registry",
    "execution_unit_registry",
    "lifecycle_log",
    "active_snapshot_id",
    "previous_snapshot_id",
    "snapshot_history"
  ],
  "properties": {
    "schema_version": {"const": "country_outage_p2_s0a_registry_set_v1"},
    "candidate_id": {"type": "string", "pattern": "^p2-s0a-[a-f0-9]{16}$"},
    "registry_revision": {"type": "integer", "minimum": 1},
    "activation_scope": {"const": "offline_candidate_only"},
    "runtime_integration": {"const": "not_implemented"},
    "capability_registry": {"$ref": "#/$defs/capabilityRegistry"},
    "execution_unit_registry": {"$ref": "#/$defs/executionUnitRegistry"},
    "lifecycle_log": {"type": "array", "items": {"$ref": "#/$defs/lifecycleEvent"}},
    "active_snapshot_id": {"type": ["string", "null"], "pattern": "^registry-snapshot-sha256:[a-f0-9]{64}$"},
    "previous_snapshot_id": {"type": ["string", "null"], "pattern": "^registry-snapshot-sha256:[a-f0-9]{64}$"},
    "snapshot_history": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^registry-snapshot-sha256:[a-f0-9]{64}$"}}
  },
  "$defs": {
    "semver": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "state": {"enum": ["discovered", "proposed", "oracle_ready", "certified", "active", "deprecated", "retired", "tombstoned"]},
    "sourceLocator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "json_pointer", "legacy_revision"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "json_pointer": {"type": "string"},
        "legacy_revision": {"type": "string", "minLength": 1}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["oracle_digest", "product_semantic_review_digest", "security_digest", "cost_audit_digest", "performance_audit_digest", "rollback_evidence_digest"],
      "properties": {
        "oracle_digest": {"$ref": "#/$defs/digest"},
        "product_semantic_review_digest": {"$ref": "#/$defs/digest"},
        "security_digest": {"$ref": "#/$defs/digest"},
        "cost_audit_digest": {"$ref": "#/$defs/digest"},
        "performance_audit_digest": {"$ref": "#/$defs/digest"},
        "rollback_evidence_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "lifecycleEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "action", "actor", "reason", "from_state", "to_state", "at_utc", "receipt_digest"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1},
        "action": {"type": "string", "minLength": 1},
        "actor": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "from_state": {"type": ["string", "null"]},
        "to_state": {"$ref": "#/$defs/state"},
        "at_utc": {"type": "string", "format": "date-time"},
        "receipt_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "unitRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit_id", "version", "contract_digest", "implementation_digest", "semantic_digest"],
      "properties": {
        "unit_id": {"type": "string", "pattern": "^(TOOL|OP)-[0-9]{2}$"},
        "version": {"$ref": "#/$defs/semver"},
        "contract_digest": {"$ref": "#/$defs/digest"},
        "implementation_digest": {"$ref": "#/$defs/digest"},
        "semantic_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "capabilityEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_id", "version", "state", "display_name_zh", "user_outcome",
        "goal_kinds", "answer_modes", "execution_units", "permission", "identity_constraints",
        "evidence_sources", "boundaries", "owner", "source", "contract_material", "semantic_material", "contract_digest",
        "implementation_digest", "semantic_digest", "oracle_refs", "certification_evidence",
        "replacement", "migration_deadline", "tombstone", "lifecycle_history"
      ],
      "properties": {
        "capability_id": {"type": "string", "pattern": "^CAP-(?:[0-9]{3}|TREND-[0-9]{3})$"},
        "version": {"$ref": "#/$defs/semver"},
        "state": {"$ref": "#/$defs/state"},
        "display_name_zh": {"type": "string", "minLength": 1},
        "user_outcome": {"type": "string", "minLength": 1},
        "goal_kinds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "answer_modes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "execution_units": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/unitRef"}},
        "permission": {"type": "string", "minLength": 1},
        "identity_constraints": {"type": "object"},
        "evidence_sources": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "boundaries": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "owner": {"type": "string", "minLength": 1},
        "source": {"$ref": "#/$defs/sourceLocator"},
        "contract_material": {"type": ["object", "null"]},
        "semantic_material": {"type": ["object", "null"]},
        "contract_digest": {"$ref": "#/$defs/digest"},
        "implementation_digest": {"$ref": "#/$defs/digest"},
        "semantic_digest": {"$ref": "#/$defs/digest"},
        "oracle_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "certification_evidence": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/evidence"}]},
        "replacement": {"type": ["object", "null"]},
        "migration_deadline": {"type": ["string", "null"], "format": "date-time"},
        "tombstone": {"type": ["object", "null"]},
        "lifecycle_history": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/lifecycleEvent"}}
      }
    },
    "executionUnitEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit_id", "version", "state", "kind", "name", "purpose", "capability_ids",
        "permission", "source_operation", "timeout_ms", "units", "null_semantics", "errors",
        "forbidden_uses", "dependencies", "implementation_files", "owner", "source", "contract_material", "semantic_material",
        "contract_digest", "implementation_digest", "semantic_digest", "oracle_refs",
        "cost_profile", "performance_profile", "certification_evidence", "replacement",
        "migration_deadline", "tombstone", "lifecycle_history"
      ],
      "properties": {
        "unit_id": {"type": "string", "pattern": "^(TOOL|OP)-[0-9]{2}$"},
        "version": {"$ref": "#/$defs/semver"},
        "state": {"$ref": "#/$defs/state"},
        "kind": {"enum": ["read_tool", "deterministic_operator"]},
        "name": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1},
        "capability_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^CAP-(?:[0-9]{3}|TREND-[0-9]{3})$"}},
        "permission": {"type": "string", "minLength": 1},
        "source_operation": {"type": "string", "minLength": 1},
        "timeout_ms": {"type": "integer", "minimum": 1},
        "units": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "null_semantics": {"type": "string", "minLength": 1},
        "errors": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "forbidden_uses": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "object"}},
        "implementation_files": {"type": "array", "items": {"type": "object"}},
        "owner": {"type": "string", "minLength": 1},
        "source": {"$ref": "#/$defs/sourceLocator"},
        "contract_material": {"type": ["object", "null"]},
        "semantic_material": {"type": ["object", "null"]},
        "contract_digest": {"$ref": "#/$defs/digest"},
        "implementation_digest": {"$ref": "#/$defs/digest"},
        "semantic_digest": {"$ref": "#/$defs/digest"},
        "oracle_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "cost_profile": {"type": "object"},
        "performance_profile": {"type": "object"},
        "certification_evidence": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/evidence"}]},
        "replacement": {"type": ["object", "null"]},
        "migration_deadline": {"type": ["string", "null"], "format": "date-time"},
        "tombstone": {"type": ["object", "null"]},
        "lifecycle_history": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/lifecycleEvent"}}
      }
    },
    "capabilityRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "registry_name", "entries"],
      "properties": {
        "schema_version": {"const": "country_outage_p2_s0a_capability_registry_v1"},
        "registry_name": {"const": "Capability Registry"},
        "entries": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/capabilityEntry"}}
      }
    },
    "executionUnitRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "registry_name", "entries"],
      "properties": {
        "schema_version": {"const": "country_outage_p2_s0a_execution_unit_registry_v1"},
        "registry_name": {"const": "Execution Unit Registry"},
        "entries": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/executionUnitEntry"}}
      }
    }
  }
}
