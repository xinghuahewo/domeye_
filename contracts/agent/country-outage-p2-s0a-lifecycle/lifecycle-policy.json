{
  "schema_version": "country_outage_p2_s0a_lifecycle_policy_v1",
  "policy_version": "1.0.0",
  "activation_scope": "offline_candidate_only",
  "runtime_integration": "not_implemented",
  "states": [
    "discovered",
    "proposed",
    "oracle_ready",
    "certified",
    "active",
    "deprecated",
    "retired",
    "tombstoned"
  ],
  "primary_transitions": {
    "discovered": ["proposed"],
    "proposed": ["oracle_ready"],
    "oracle_ready": ["certified"],
    "certified": ["active"],
    "active": ["deprecated"],
    "deprecated": ["active", "retired"],
    "retired": ["tombstoned"],
    "tombstoned": []
  },
  "state_entry_requirements": {
    "proposed": ["stable_id", "version", "owner", "impact_analysis", "contract_digest", "semantic_digest"],
    "oracle_ready": ["oracle_digest", "normal", "missing", "null", "wrong_identity", "unavailable", "boundary"],
    "certified": ["oracle_digest", "product_semantic_review_digest", "security_digest", "cost_audit_digest", "performance_audit_digest", "rollback_evidence_digest"],
    "active": ["registry_snapshot_id", "activation_approval", "all_dependencies_active"],
    "deprecated": ["replacement_or_no_replacement_reason", "migration_deadline", "affected_consumers"],
    "retired": ["not_selected_by_active_snapshot", "no_inflight_plan", "historical_replay_ready"],
    "tombstoned": ["retirement_receipt", "retained_identity", "retained_digests", "id_reuse_forbidden"]
  },
  "plan_admission": {
    "required_state": "active",
    "require_bound_snapshot": true,
    "require_exact_version": true,
    "require_contract_digest": true,
    "require_implementation_digest": true,
    "require_semantic_digest": true,
    "non_active_behavior": "reject_before_execution",
    "runtime_enforcement_status": "contract_and_offline_validator_only"
  },
  "roles": {
    "registry:read": ["read", "impact", "check_plan"],
    "registry:propose": ["create", "update"],
    "registry:certify": ["transition:oracle_ready", "transition:certified"],
    "registry:activate": ["transition:active", "transition:deprecated", "snapshot"],
    "registry:retire": ["transition:retired"],
    "registry:tombstone": ["delete"],
    "registry:rollback": ["rollback_unit", "rollback_edition"]
  },
  "separation_of_duties": {
    "builder_role": "registry-governance-builder-v1",
    "reviewer_role": "product-semantic-reviewer-v1",
    "reviewer_must_differ_from_builder": true,
    "activation_approver_must_differ_from_builder": true
  },
  "semver": {
    "patch": "向后兼容的澄清、等价修复或性能改善；不得改变既有合法输入输出、身份、单位、错误、null 或边界",
    "minor": "向后兼容地增加可选输入输出、错误细分或能力映射；旧 Oracle 必须继续通过",
    "major": "任何删除、收紧、单位/人口/null/身份/错误/权限/证据/确定性或产品语义变化",
    "same_id_new_user_outcome": "forbidden_create_new_capability_id"
  },
  "identity": {
    "stable_id_reuse": "forbidden",
    "stable_id_version_mutation": "forbidden",
    "registry_revision": "strictly_monotonic_integer",
    "snapshot_identity": "sha256_canonical_content",
    "digest_algorithm": "sha256"
  },
  "boundaries": {
    "event_type": "country_outage",
    "collector_id": "rrc25",
    "access": "read_only",
    "required_event_identity": [
      "incident_id",
      "publication_id",
      "revision",
      "collector_id",
      "cohort_id",
      "window_start_utc",
      "window_end_utc",
      "data_through",
      "is_final_in_data_range",
      "lifecycle_state"
    ],
    "forbidden_claims": [
      "cause",
      "responsibility",
      "government_action",
      "recovery",
      "real_user_impact",
      "national_outage",
      "traffic_impact",
      "network_rca"
    ],
    "production_deployment": "forbidden_in_p2_s0a"
  }
}
