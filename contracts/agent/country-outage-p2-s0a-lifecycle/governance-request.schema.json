{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domeye.local/contracts/country-outage-p2-s0a-governance-request-v1.schema.json",
  "title": "P2-S0A 离线治理请求",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "action", "expected_registry_revision", "actor", "reason", "target"],
  "properties": {
    "schema_version": {"const": "country_outage_p2_s0a_governance_request_v1"},
    "request_id": {"type": "string", "pattern": "^govreq-[A-Za-z0-9._-]{1,64}$"},
    "action": {"enum": ["create", "read", "update", "impact", "transition", "delete", "snapshot", "check_plan", "rollback_unit", "rollback_edition"]},
    "expected_registry_revision": {"type": "integer", "minimum": 1},
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor_id", "roles"],
      "properties": {
        "actor_id": {"type": "string", "minLength": 1},
        "roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^registry:[a-z_]+$"}}
      }
    },
    "reason": {"type": "string", "minLength": 8},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "stable_id", "version"],
      "properties": {
        "kind": {"enum": ["capability", "execution_unit", "registry_set"]},
        "stable_id": {"type": ["string", "null"]},
        "version": {"type": ["string", "null"], "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"}
      }
    },
    "to_state": {"enum": ["discovered", "proposed", "oracle_ready", "certified", "active", "deprecated", "retired", "tombstoned"]},
    "entry": {"type": "object"},
    "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "replacement": {"type": ["object", "null"]},
    "migration_deadline": {"type": ["string", "null"], "format": "date-time"},
    "snapshot_path": {"type": ["string", "null"]}
  }
}
