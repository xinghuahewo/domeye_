{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domeye.local/contracts/agent/country-outage-trend-analysis-s0-v1.schema.json",
  "title": "国家中断趋势分析 S0 基线合同",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "baseline_id",
    "stage",
    "status",
    "effect_contract",
    "boundaries",
    "vocabulary",
    "capability_inventory",
    "reference_data",
    "acceptance_curves",
    "user_tasks",
    "refusal_cases",
    "value_gate",
    "identity_separation"
  ],
  "properties": {
    "schema_version": {
      "const": "country_outage_trend_analysis_s0_v1"
    },
    "baseline_id": {
      "type": "string",
      "pattern": "^trend_s0_[a-z0-9_]+$"
    },
    "stage": {
      "const": "S0"
    },
    "status": {
      "const": "design_baseline_not_implementation_evidence"
    },
    "effect_contract": {
      "$ref": "#/$defs/effectContract"
    },
    "boundaries": {
      "$ref": "#/$defs/boundaries"
    },
    "vocabulary": {
      "$ref": "#/$defs/vocabulary"
    },
    "capability_inventory": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/capability"
      }
    },
    "reference_data": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/referenceData"
      }
    },
    "acceptance_curves": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "$ref": "#/$defs/acceptanceCurve"
      }
    },
    "user_tasks": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/userTask"
      }
    },
    "refusal_cases": {
      "type": "array",
      "minItems": 6,
      "items": {
        "$ref": "#/$defs/refusalCase"
      }
    },
    "value_gate": {
      "$ref": "#/$defs/valueGate"
    },
    "identity_separation": {
      "$ref": "#/$defs/identitySeparation"
    }
  },
  "$defs": {
    "effectContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acceptance_path",
        "acceptance_sha256",
        "plan_path",
        "plan_sha256",
        "contract_commit"
      ],
      "properties": {
        "acceptance_path": {"const": "docs/国家中断趋势分析最终验收文档.md"},
        "acceptance_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "plan_path": {"const": "docs/国家中断趋势分析分阶段计划.md"},
        "plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "contract_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "collector",
        "collector_count",
        "observation_scope",
        "snapshot_mode",
        "prohibited_capabilities",
        "prohibited_claims"
      ],
      "properties": {
        "collector": {"const": "rrc25"},
        "collector_count": {"const": 1},
        "observation_scope": {"const": "bgp_control_plane"},
        "snapshot_mode": {"const": "fixed_read_only"},
        "prohibited_capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "prohibited_claims": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string"}
        }
      }
    },
    "vocabulary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline_types",
        "quality_states",
        "slot_states",
        "pattern_statuses",
        "atomic_states",
        "asn_states",
        "statistical_populations",
        "units"
      ],
      "properties": {
        "baseline_types": {"$ref": "#/$defs/uniqueStrings"},
        "quality_states": {"$ref": "#/$defs/uniqueStrings"},
        "slot_states": {"$ref": "#/$defs/uniqueStrings"},
        "pattern_statuses": {"$ref": "#/$defs/uniqueStrings"},
        "atomic_states": {"$ref": "#/$defs/uniqueStrings"},
        "asn_states": {"$ref": "#/$defs/uniqueStrings"},
        "statistical_populations": {"$ref": "#/$defs/uniqueStrings"},
        "units": {"$ref": "#/$defs/uniqueStrings"}
      }
    },
    "uniqueStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "state", "evidence", "boundary"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "state": {
          "enum": [
            "existing_source",
            "data_exists_not_productized",
            "target",
            "absent_out_of_scope",
            "runtime_unverified"
          ]
        },
        "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "boundary": {"type": "string", "minLength": 1}
      }
    },
    "referenceData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "evidence_status", "identity", "scale", "not_proof_of"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "evidence_status": {"const": "historical_accepted_artifact"},
        "identity": {"type": "object"},
        "scale": {"type": "object"},
        "not_proof_of": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "offset_seconds", "state", "value"],
      "properties": {
        "index": {"type": "integer", "minimum": 0},
        "offset_seconds": {"type": "integer", "minimum": 0},
        "state": {
          "enum": [
            "observed",
            "missing",
            "unknown",
            "source_unavailable",
            "processing_gap",
            "not_observed"
          ]
        },
        "value": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "keyPoints": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [
        "start_index",
        "end_index",
        "extreme_index",
        "largest_drop_end_index",
        "largest_recovery_end_index"
      ],
      "properties": {
        "start_index": {"type": "integer", "minimum": 0},
        "end_index": {"type": "integer", "minimum": 0},
        "extreme_index": {"type": "integer", "minimum": 0},
        "largest_drop_end_index": {"type": "integer", "minimum": 1},
        "largest_recovery_end_index": {"type": "integer", "minimum": 1}
      }
    },
    "acceptanceCurve": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "denominator",
        "slot_seconds",
        "baseline_type",
        "slots",
        "expected"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^CURVE-[0-9]{2}$"},
        "type": {
          "enum": [
            "single_wave",
            "multi_wave",
            "oscillation",
            "plateau",
            "mixed",
            "unmatched",
            "small_denominator",
            "missing_slots",
            "unknown"
          ]
        },
        "denominator": {"type": "integer", "minimum": 1},
        "slot_seconds": {"const": 300},
        "baseline_type": {
          "enum": ["fixed_cohort", "window_start", "contemporaneous_reference", "unavailable"]
        },
        "slots": {"type": "array", "minItems": 12, "maxItems": 12, "items": {"$ref": "#/$defs/slot"}},
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "quality_status",
            "pattern_status",
            "pattern_label",
            "required_atomic_states",
            "observed_slot_count",
            "non_observed_slot_count",
            "slot_state_counts",
            "key_points",
            "warnings"
          ],
          "properties": {
            "quality_status": {"enum": ["complete", "degraded", "unavailable"]},
            "pattern_status": {"enum": ["matched", "mixed", "unmatched", "insufficient_data"]},
            "pattern_label": {"type": ["string", "null"]},
            "required_atomic_states": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
            "observed_slot_count": {"type": "integer", "minimum": 0},
            "non_observed_slot_count": {"type": "integer", "minimum": 0},
            "slot_state_counts": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {"type": "integer", "minimum": 1}
            },
            "key_points": {"$ref": "#/$defs/keyPoints"},
            "warnings": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
          }
        }
      }
    },
    "userTask": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "question", "required_outputs", "success_condition"],
      "properties": {
        "id": {"type": "string", "pattern": "^UT-0[1-5]$"},
        "question": {"type": "string", "minLength": 1},
        "required_outputs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "success_condition": {"type": "string", "minLength": 1}
      }
    },
    "refusalCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "question", "required_disposition", "required_unknown"],
      "properties": {
        "id": {"type": "string", "pattern": "^RF-[0-9]{2}$"},
        "question": {"type": "string", "minLength": 1},
        "required_disposition": {"const": "abstain"},
        "required_unknown": {"type": "string", "minLength": 1}
      }
    },
    "valueGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baselines", "candidate", "metrics", "pass_rule"],
      "properties": {
        "baselines": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/valueSystem"}},
        "candidate": {"$ref": "#/$defs/valueSystem"},
        "metrics": {"type": "array", "minItems": 5, "items": {"$ref": "#/$defs/valueMetric"}},
        "pass_rule": {"type": "string", "minLength": 1}
      }
    },
    "valueSystem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "measurement_status"],
      "properties": {
        "id": {"enum": ["B0", "B1", "B2"]},
        "description": {"type": "string", "minLength": 1},
        "measurement_status": {"const": "to_measure"}
      }
    },
    "valueMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "target", "measurement_status"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "target": {"type": ["number", "string"]},
        "measurement_status": {"const": "to_measure"}
      }
    },
    "identitySeparation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_candidate", "data_artifacts", "target_effects", "current_runtime", "production_claim"],
      "properties": {
        "source_candidate": {"const": "contract_commit_only"},
        "data_artifacts": {"const": "historical_accepted"},
        "target_effects": {"const": "not_implemented_in_s0"},
        "current_runtime": {"const": "runtime_unverified"},
        "production_claim": {"const": "not_claimed"}
      }
    }
  }
}
