    "content_digest": "sha256(canonical({members}))",
    "result_set_id": "result-set-sha256: + sha256(canonical({source_identity,source_tool,normalized_query,stable_sort,source_population_id,source_population_schema_ref,source_population_schema_digest,source_dataset_digest}))",
    "preview_view_digest": "sha256(canonical(preview excluding view_digest))"
