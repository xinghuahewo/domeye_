      {
        "validator_id": "source_incomplete_provenance_closure",
        "checks": [
          "source_incomplete_receipt_resolves",
          "receipt_identity_matches_frozen_validator",
          "receipt_binds_tool_population_dataset_limitations_counts_and_resume_token"
        ],
        "failure_disposition": "reject_result_set_freeze"
      },
      {
        "validator_id": "preview_source_binding_and_count_closure",
        "checks": [
          "preview_source_result_set_id_and_revision_equal_root",
          "preview_stable_sort_digest_equals_root",
          "preview_member_refs_are_subset_of_root_members",
          "preview_returned_count_equals_member_ref_count",
          "preview_returned_count_not_greater_than_limit"
        ],
        "failure_disposition": "reject_preview"
      },
      {
        "validator_id": "complete_export_eligibility",
        "checks": [
          "result_set_state_is_frozen",
          "set_completeness_is_complete",
          "all_page_count_digest_and_identity_closure_valid"
        ],
        "failure_disposition": "reject_export"
      },
      {
        "validator_id": "complete_export_artifact_closure",
        "checks": [
          "authorization_receipt_resolves_and_binds_result_set_revision_and_format",
          "manifest_member_digests_equal_frozen_result_set_order",
          "manifest_member_count_equals_result_set_total",
          "actual_export_bytes_sha256_equals_manifest_and_staged_artifact",
          "llm_member_regeneration_absent"
        ],
        "failure_disposition": "reject_export_before_final_reference_replace"
      }
    ]
  }
}
