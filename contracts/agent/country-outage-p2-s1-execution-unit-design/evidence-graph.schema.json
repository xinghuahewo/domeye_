{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domeye.example/contracts/agent/country-outage-p2-s1/evidence-graph.schema.json",
  "title": "RRC25 调查 Evidence Graph 合同",
  "description": "只包含同一绑定下的观测事实、确定性派生事实、结果集、限制、未知和执行失败；世界知识与假设不得写入事实图。",
  "x-contract-metadata": {
    "artifact_id": "country-outage-p2-s1d4-evidence-graph-20260812",
    "stage": "S1D-4",
    "status": "design_contract_only"
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "graph_id",
    "graph_revision",
    "parent_graph_revision",
    "graph_state",
    "investigation_id",
    "investigation_revision",
    "plan_id",
    "plan_revision",
    "plan_digest",
    "identity_digest",
    "registry_snapshot_id",
    "registry_snapshot_digest",
    "nodes",
    "edges",
    "root_node_ids",
    "closure_receipt_digest",
    "graph_digest",
    "commit_receipt_digest",
    "design_boundary"
  ],
  "properties": {
    "schema_version": {
      "const": "country_outage_p2_evidence_graph_v1"
    },
    "graph_id": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "graph_revision": {
      "type": "integer",
      "minimum": 1
    },
    "parent_graph_revision": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "graph_state": {
      "enum": [
        "prepared",
        "committed",
        "invalidated"
      ]
    },
    "investigation_id": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "investigation_revision": {
      "type": "integer",
      "minimum": 1
    },
    "plan_id": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "plan_revision": {
      "type": "integer",
      "minimum": 1
    },
    "plan_digest": {
      "$ref": "#/$defs/sha256"
    },
    "identity_digest": {
      "$ref": "#/$defs/sha256"
    },
    "registry_snapshot_id": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "registry_snapshot_digest": {
      "$ref": "#/$defs/sha256"
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/graphNode"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/graphEdge"
      }
    },
    "root_node_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "closure_receipt_digest": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "graph_digest": {
      "$ref": "#/$defs/sha256"
    },
    "commit_receipt_digest": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "design_boundary": {
      "$ref": "#/$defs/designBoundary"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "graph_revision": {
            "const": 1
          }
        },
        "required": [
          "graph_revision"
        ]
      },
      "then": {
        "properties": {
          "parent_graph_revision": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "parent_graph_revision": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "graph_state": {
            "const": "committed"
          }
        },
        "required": [
          "graph_state"
        ]
      },
      "then": {
        "properties": {
          "closure_receipt_digest": {
            "$ref": "#/$defs/sha256"
          },
          "commit_receipt_digest": {
            "$ref": "#/$defs/sha256"
          },
          "nodes": {
            "items": {
              "allOf": [
                {
                  "$ref": "#/$defs/graphNode"
                },
                {
                  "properties": {
                    "committed": {
                      "const": true
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "producerRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producer_kind",
        "producer_id",
        "producer_version",
        "contract_digest",
        "run_receipt_digest"
      ],
      "properties": {
        "producer_kind": {
          "enum": [
            "tool",
            "operator",
            "host_gate",
            "host_boundary",
            "host_commit"
          ]
        },
        "producer_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "producer_version": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "contract_digest": {
          "$ref": "#/$defs/sha256"
        },
        "run_receipt_digest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "graphNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "node_type",
        "identity_digest",
        "producer_ref",
        "provenance_node_ids",
        "evidence_refs",
        "completeness",
        "payload",
        "payload_digest",
        "committed"
      ],
      "properties": {
        "node_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "node_type": {
          "enum": [
            "observed_fact",
            "derived_fact",
            "result_set",
            "limitation",
            "unknown",
            "execution_failure"
          ]
        },
        "identity_digest": {
          "$ref": "#/$defs/sha256"
        },
        "producer_ref": {
          "$ref": "#/$defs/producerRef"
        },
        "provenance_node_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "completeness": {
          "enum": [
            "complete",
            "partial_page",
            "source_incomplete",
            "not_applicable"
          ]
        },
        "payload": {
          "oneOf": [
            {
              "$ref": "#/$defs/observedFactPayload"
            },
            {
              "$ref": "#/$defs/derivedFactPayload"
            },
            {
              "$ref": "#/$defs/resultSetPayload"
            },
            {
              "$ref": "#/$defs/limitationPayload"
            },
            {
              "$ref": "#/$defs/unknownPayload"
            },
            {
              "$ref": "#/$defs/executionFailurePayload"
            }
          ]
        },
        "payload_digest": {
          "$ref": "#/$defs/sha256"
        },
        "committed": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "node_type": {
                "const": "observed_fact"
              }
            },
            "required": [
              "node_type"
            ]
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/observedFactPayload"
              },
              "evidence_refs": {
                "minItems": 1
              },
              "producer_ref": {
                "properties": {
                  "producer_kind": {
                    "const": "tool"
                  }
                },
                "required": [
                  "producer_kind"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "node_type": {
                "const": "derived_fact"
              }
            },
            "required": [
              "node_type"
            ]
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/derivedFactPayload"
              },
              "provenance_node_ids": {
                "minItems": 1
              },
              "evidence_refs": {
                "minItems": 1
              },
              "producer_ref": {
                "properties": {
                  "producer_kind": {
                    "const": "operator"
                  }
                },
                "required": [
                  "producer_kind"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "node_type": {
                "const": "result_set"
              }
            },
            "required": [
              "node_type"
            ]
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/resultSetPayload"
              },
              "producer_ref": {
                "properties": {
                  "producer_kind": {
                    "const": "tool"
                  }
                },
                "required": [
                  "producer_kind"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "node_type": {
                "const": "limitation"
              }
            },
            "required": [
              "node_type"
            ]
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/limitationPayload"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "node_type": {
                "const": "unknown"
              }
            },
            "required": [
              "node_type"
            ]
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/unknownPayload"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "node_type": {
                "const": "execution_failure"
              }
            },
            "required": [
              "node_type"
            ]
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/executionFailurePayload"
              },
              "completeness": {
                "const": "not_applicable"
              }
            }
          }
        }
      ]
    },
    "observedFactPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "payload_type",
        "fact_id",
        "fact_schema_ref",
        "fact_value_digest",
        "source_result_set_ref",
        "fact_value_projection"
      ],
      "properties": {
        "payload_type": {
          "const": "observed_fact"
        },
        "fact_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "fact_schema_ref": {
          "type": "string",
          "format": "uri-reference"
        },
        "fact_value_digest": {
          "$ref": "#/$defs/sha256"
        },
        "fact_value_projection": {
          "oneOf": [
            {
              "$ref": "#/$defs/factValueProjection"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_result_set_ref": {
          "oneOf": [
            {
              "$ref": "#/$defs/resultSetReference"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "factValueProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value_schema_ref",
        "value",
        "value_digest"
      ],
      "properties": {
        "value_schema_ref": {
          "const": "https://domeye.example/types/asn.json"
        },
        "value": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "value_digest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "resultSetReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result_set_id",
        "result_set_revision",
        "manifest_digest",
        "content_digest",
        "freeze_receipt_digest",
        "source_scope",
        "member_ref",
        "member_digest",
        "projection_receipt_digest",
        "source_completeness"
      ],
      "properties": {
        "result_set_id": {
          "type": "string",
          "pattern": "^result-set-sha256:[0-9a-f]{64}$"
        },
        "result_set_revision": {
          "type": "integer",
          "minimum": 1
        },
        "manifest_digest": {
          "$ref": "#/$defs/sha256"
        },
        "content_digest": {
          "$ref": "#/$defs/sha256"
        },
        "freeze_receipt_digest": {
          "$ref": "#/$defs/sha256"
        },
        "source_scope": {
          "const": "member"
        },
        "member_ref": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "member_digest": {
          "$ref": "#/$defs/sha256"
        },
        "projection_receipt_digest": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_completeness": {
          "enum": [
            "complete",
            "partial_page",
            "source_incomplete"
          ]
        }
      }
    },
    "derivedFactPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "payload_type",
        "fact_id",
        "operator_id",
        "operator_output_digest",
        "operator_input_digests"
      ],
      "properties": {
        "payload_type": {
          "const": "derived_fact"
        },
        "fact_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "operator_id": {
          "type": "string",
          "pattern": "^OP-[0-9]{2}$"
        },
        "operator_output_digest": {
          "$ref": "#/$defs/sha256"
        },
        "operator_input_digests": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    "resultSetPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "payload_type",
        "result_set_id",
        "result_set_revision",
        "manifest_digest",
        "content_digest",
        "view_ref"
      ],
      "properties": {
        "payload_type": {
          "const": "result_set"
        },
        "result_set_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "result_set_revision": {
          "type": "integer",
          "minimum": 1
        },
        "manifest_digest": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "content_digest": {
          "$ref": "#/$defs/sha256"
        },
        "view_ref": {
          "oneOf": [
            {
              "$ref": "#/$defs/nonEmptyString"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "limitationPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "payload_type",
        "limitation_code",
        "scope",
        "affected_node_ids",
        "description"
      ],
      "properties": {
        "payload_type": {
          "const": "limitation"
        },
        "limitation_code": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "scope": {
          "enum": [
            "collector",
            "sample",
            "population",
            "unit",
            "time",
            "path",
            "external_evidence"
          ]
        },
        "affected_node_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "description": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "unknownPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "payload_type",
        "unknown_code",
        "reason",
        "external_evidence_required"
      ],
      "properties": {
        "payload_type": {
          "const": "unknown"
        },
        "unknown_code": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "reason": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "external_evidence_required": {
          "type": "boolean"
        }
      }
    },
    "executionFailurePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "payload_type",
        "failure_receipt_ref",
        "failure_kind",
        "affected_scope",
        "publishable_fact_output"
      ],
      "properties": {
        "payload_type": {
          "const": "execution_failure"
        },
        "failure_receipt_ref": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "failure_kind": {
          "enum": [
            "failed",
            "cancelled",
            "skipped_dependency_failed",
            "unavailable"
          ]
        },
        "affected_scope": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "publishable_fact_output": {
          "const": false
        }
      }
    },
    "relationNodeBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "node_payload_digest",
        "domain_value_digest",
        "typed_value_schema_ref",
        "typed_value"
      ],
      "properties": {
        "node_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "node_payload_digest": {
          "$ref": "#/$defs/sha256"
        },
        "domain_value_digest": {
          "$ref": "#/$defs/sha256"
        },
        "typed_value_schema_ref": {
          "oneOf": [
            {
              "type": "string",
              "format": "uri-reference"
            },
            {
              "type": "null"
            }
          ]
        },
        "typed_value": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "relationOperatorBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operator_id",
        "operator_version",
        "contract_digest",
        "run_receipt_digest",
        "output_schema_ref",
        "output_digest"
      ],
      "properties": {
        "operator_id": {
          "type": "string",
          "pattern": "^OP-[0-9]{2}$"
        },
        "operator_version": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "contract_digest": {
          "$ref": "#/$defs/sha256"
        },
        "run_receipt_digest": {
          "$ref": "#/$defs/sha256"
        },
        "output_schema_ref": {
          "type": "string",
          "pattern": "^(operator-contract\\.schema\\.json|https://domeye\\.internal/contracts/agent/country-outage-p2-s1/operator-contract\\.schema\\.json)#/\\$defs/op(15|16|25|27|29|33|37)OutputEnvelope$"
        },
        "output_digest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "pathContainsProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "target_asn",
        "ordered_positions",
        "path_digest",
        "path_canonicalization_profile_id",
        "path_canonicalization_profile_digest",
        "operator_input_digest"
      ],
      "properties": {
        "outcome": {
          "const": "found"
        },
        "target_asn": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "ordered_positions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "path_digest": {
          "$ref": "#/$defs/sha256"
        },
        "path_canonicalization_profile_id": {
          "const": "AS-PATH-CANONICALIZATION-1.0.0"
        },
        "path_canonicalization_profile_digest": {
          "const": "eb4d2081ee69ab0254b7af461122cf315b6bcdf24551c22de7e8dccc6d965966"
        },
        "operator_input_digest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "directAdjacencyProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_asn",
        "neighbor_side",
        "target_position",
        "neighbor_position",
        "neighbor_asn",
        "path_digest",
        "position_receipt_digest"
      ],
      "properties": {
        "target_asn": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "neighbor_side": {
          "enum": [
            "left",
            "right"
          ]
        },
        "target_position": {
          "type": "integer",
          "minimum": 0
        },
        "neighbor_position": {
          "type": "integer",
          "minimum": 0
        },
        "neighbor_asn": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "path_digest": {
          "$ref": "#/$defs/sha256"
        },
        "position_receipt_digest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "setIntersectionProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intersection_set_digest",
        "intersection_count",
        "left_digest",
        "right_digest"
      ],
      "properties": {
        "intersection_set_digest": {
          "$ref": "#/$defs/sha256"
        },
        "intersection_count": {
          "type": "integer",
          "minimum": 1
        },
        "left_digest": {
          "$ref": "#/$defs/sha256"
        },
        "right_digest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "setContainsProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "direction",
        "intersection_count",
        "denominator_count",
        "ratio_exact",
        "outcome",
        "left_digest",
        "right_digest"
      ],
      "properties": {
        "direction": {
          "const": "intersection_over_left"
        },
        "intersection_count": {
          "type": "integer",
          "minimum": 0
        },
        "denominator_count": {
          "type": "integer",
          "minimum": 1
        },
        "ratio_exact": {
          "const": "1/1"
        },
        "outcome": {
          "const": "computed"
        },
        "left_digest": {
          "$ref": "#/$defs/sha256"
        },
        "right_digest": {
          "$ref": "#/$defs/sha256"
        }
      }
