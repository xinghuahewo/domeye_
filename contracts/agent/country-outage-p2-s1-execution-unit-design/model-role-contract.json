      "prompt_digest",
      "policy_version",
      "policy_digest"
    ],
    "same_grounding_plan_required": true,
    "same_evidence_bundle_required": true,
    "same_registry_snapshot_required": true,
    "same_publication_required": true,
    "student_additional_inputs_allowed": [
      "validated_teacher_reference",
      "teacher_reference_validation_receipt"
    ],
    "student_additional_input_may_change_shared_binding": false
