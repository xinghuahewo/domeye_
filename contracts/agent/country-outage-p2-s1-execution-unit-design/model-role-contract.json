      "teacher_validation_receipt_digest",
      "claims",
      "evidence_refs",
      "limitations",
      "unknowns",
      "answer_text",
      "output_digest"
    ],
    "validation_receipt_required_before_publish": true,
    "unvalidated_answer_publishable": false
  },
  "feedback_and_revision_policy": {
    "structured_difference_feedback_max": 1,
    "student_revision_max": 1,
    "feedback_allowed_fields": [
