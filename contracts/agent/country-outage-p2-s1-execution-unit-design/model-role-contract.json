      "gates": ["GATE-01", "GATE-02", "GATE-03", "GATE-04", "GATE-05"],
      "all_gates_required": true,
      "failed_reference_forwarded_to_student": false
    },
    "ds_student_answer_generator": {
      "logical_alias": "ds_student",
      "identity_status": "pending_freeze_before_s1d5",
      "provider": "MUST_FREEZE_BY_S1D5",
      "model": "MUST_FREEZE_BY_S1D5",
      "version": "MUST_FREEZE_BY_S1D5",
      "latest_alias_forbidden": true,
      "allowed_output_schema": "StudentAnswer",
      "required_inputs": [
        "validated_user_goal",
        "admitted_grounding_plan",
        "validated_evidence_bundle",
        "registry_snapshot",
        "validated_teacher_reference",
        "boundary_policy"
      ],
      "tool_selection_authority": false,
      "tool_execution_allowed": false,
      "may_change_grounding_plan": false,
      "may_change_evidence_bundle": false,
      "fact_publication_authority": false,
      "state_write_allowed": false
    },
    "student_answer_validator": {
      "owner_kind": "host_validation_pipeline",
      "gates": ["GATE-01", "GATE-02", "GATE-03", "GATE-04", "GATE-05"],
      "all_gates_required": true,
      "failed_answer_publishable": false
    },
    "alignment_evaluator": {
      "owner_kind": "host_deterministic_evaluator",
      "teacher_is_truth_oracle": false,
      "hard_gate_metrics": ["fact_precision", "evidence_ref_precision", "boundary_compliance"],
      "scored_metrics": ["intent_coverage", "fact_recall", "structure_coverage", "uncertainty_coverage"],
      "advisory_metrics": ["text_similarity"],
      "text_similarity_is_sufficient": false
    }
  },
  "ds_student_identity": {
    "logical_alias": "ds_student",
    "provider": null,
    "model": null,
    "version": null,
    "status": "pending_freeze",
