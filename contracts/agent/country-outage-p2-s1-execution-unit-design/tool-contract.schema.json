{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domeye.internal/contracts/agent/country-outage-p2-s1/tool-contract.schema.json",
  "title": "RRC25国家中断P2-S1原子读Tool合同",
  "description": "设计阶段 schema；不声明运行时已实现或生产已部署。",
  "type": "object",
  "required": [
    "unit_id",
    "name",
    "version",
    "disposition",
    "atomic_capability_id",
    "single_responsibility",
    "source_population",
    "source_schema_ref",
    "source_readiness",
    "input_contract",
    "input_field_schemas",
    "output_population",
    "member_identity",
    "output_member_fields",
    "output_field_schemas",
    "stable_sort",
    "dedupe_key",
    "pagination_contract_ref",
    "evidence_contract",
    "forbidden_embedded_actions",
    "forbidden_conclusions",
    "question_refs",
    "composition_location",
    "embedded_capabilities",
    "split_test",
    "runtime_ready_claim"
  ],
  "properties": {
    "unit_id": {"type": "string", "pattern": "^TOOL-(0[7-9]|1[0-3])$"},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+-design$"},
    "disposition": {"type": "string", "enum": ["new_p2_v1_source_schema_required", "new_p2_v1_homogeneous_source_schema_required", "new_p2_v1_source_view_required", "deferred_p2_1"]},
    "atomic_capability_id": {"type": "string", "pattern": "^read\\.[a-z0-9_.]+$"},
    "single_responsibility": {"type": "string", "minLength": 1},
    "source_population": {"type": "string", "minLength": 1},
    "source_schema_ref": {"type": "string", "minLength": 1},
    "source_readiness": {"type": "string", "enum": ["schema_projection_required_before_implementation", "row_schema_required_before_implementation", "homogeneous_row_schema_required_before_implementation", "materialized_view_and_projection_receipt_required_before_implementation", "association_row_and_path_quality_schema_required_before_implementation", "deferred_registry_and_manifest_binding_required"]},
    "input_contract": {
      "type": "object",
      "required": ["required", "optional", "optional_filters", "page_size_min", "page_size_max"],
      "properties": {
        "required": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
        "optional": {"type": "array", "items": {"type": "string"}, "contains": {"const": "page_token"}, "uniqueItems": true},
        "optional_filters": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "mutually_exclusive": {"type": "array"},
        "page_size_min": {"const": 1},
        "page_size_max": {"type": "integer", "minimum": 1},
        "time_grid": {"type": "string"},
        "silent_time_rounding": {"const": false},
        "exact_grid_match_required": {"const": true},
        "future_state_read_forbidden": {"const": true},
        "filter_contract": {"type": "string"},
        "unbounded_window_forbidden": {"const": true}
      },
      "additionalProperties": false
    },
    "input_field_schemas": {"type": "object", "minProperties": 3, "additionalProperties": {"type": "object"}},
    "output_population": {"type": "string", "minLength": 1},
    "member_identity": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "output_member_fields": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "output_field_schemas": {"type": "object", "minProperties": 3, "additionalProperties": {"type": "object"}},
    "state_enum": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "time_semantics": {"type": "string"},
    "state_time_semantics": {"type": "string"},
    "active_path_rule": {"type": "string"},
    "invisible_path_rule": {"type": "string"},
    "withdraw_rule": {"type": "string"},
    "asn_filter_semantics": {"type": "string"},
    "direction_identity_contract": {"type": "object"},
    "contains_asn_filter_contract": {
      "type": "object",
      "required": [
        "source",
        "profile_id",
        "eligible_row_predicate",
        "query_time_path_parsing_forbidden",
        "llm_filtering_forbidden",
        "trusted_query_receipt_required_when_filter_present",
        "query_receipt_must_bind",
        "returned_member_validation",
        "completeness_proof"
      ],
      "properties": {
        "source": {"const": "pre_materialized_path_asn_membership_index_on_same_route_state_population"},
        "profile_id": {"const": "PROFILE-PATH-ASN-MEMBERSHIP-1.0.0"},
        "eligible_row_predicate": {"const": "visibility=visible AND common_path_status IN (ordered,unordered)"},
        "query_time_path_parsing_forbidden": {"const": true},
        "llm_filtering_forbidden": {"const": true},
        "trusted_query_receipt_required_when_filter_present": {"const": true},
        "query_receipt_must_bind": {
          "type": "array",
          "minItems": 15,
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "returned_member_validation": {"type": "string", "minLength": 1},
        "completeness_proof": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "native_filter_contract": {
      "type": "object",
      "required": [
        "source",
        "profile_id",
        "profile_digest",
        "filters",
        "query_time_path_parsing_forbidden",
        "llm_filtering_forbidden",
        "trusted_query_receipt_required_when_filter_present",
        "query_receipt_must_bind",
        "returned_member_validation",
        "completeness_proof"
      ],
      "properties": {
        "source": {"const": "pre_materialized_indexes_on_same_window_path_association_population"},
        "profile_id": {"const": "PROFILE-WINDOW-PATH-ASSOCIATION-FILTER-1.0.0"},
        "profile_digest": {"const": "46ca0955b30a4d43088c214ec5bdf84fbf9b65987bd65047257e85e1d7778eb7"},
        "filters": {"type": "array", "const": ["contains_asn", "anchor_asn_plus_anchor_before_known_origin"]},
        "query_time_path_parsing_forbidden": {"const": true},
        "llm_filtering_forbidden": {"const": true},
        "trusted_query_receipt_required_when_filter_present": {"const": true},
        "query_receipt_must_bind": {"type": "array", "minItems": 21, "uniqueItems": true, "items": {"type": "string"}},
        "returned_member_validation": {"type": "string", "minLength": 1},
        "completeness_proof": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "association_population_domain": {"type": "object"},
    "source_adapter_mapping": {"type": "object"},
    "source_population_contract": {"type": "object"},
    "output_row_constraints": {"type": "object"},
    "stable_sort": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "dedupe_key": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "pagination_contract_ref": {"const": "#/common_result_set_contract"},
    "evidence_contract": {"type": "string", "minLength": 1},
    "forbidden_embedded_actions": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "forbidden_conclusions": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "question_refs": {"type": "array", "items": {"type": "string", "pattern": "^Q[0-9]{2}$"}, "minItems": 1, "uniqueItems": true},
    "composition_location": {"const": "investigation_plan"},
    "embedded_capabilities": {"type": "array", "maxItems": 0},
    "runtime_ready_claim": {"const": false},
    "split_test": {
      "type": "object",
      "required": [
        "business_read_count",
        "fact_population_count",
        "mode_changes_population",
        "independently_publishable_subreads",
        "internally_invokes_other_units",
        "disposition"
      ],
      "properties": {
        "business_read_count": {"const": 1},
        "fact_population_count": {"const": 1},
        "mode_changes_population": {"const": false},
        "independently_publishable_subreads": {"const": false},
        "internally_invokes_other_units": {"const": false},
        "disposition": {"const": "atomic_as_designed"}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {"properties": {"unit_id": {"const": "TOOL-07"}}, "required": ["unit_id"]},
      "then": {"required":["asn_filter_semantics","direction_identity_contract"],"properties": {"name":{"const":"query_fixed_cohort_members"},"source_population":{"const":"fixed_cohort_member_rows"},"output_population":{"const":"fixed_cohort_member_rows"},"disposition":{"const":"new_p2_v1_source_schema_required"},"source_readiness":{"const":"schema_projection_required_before_implementation"}}}
    },
    {
      "if": {"properties": {"unit_id": {"const": "TOOL-08"}}, "required": ["unit_id"]},
      "then": {"properties": {"name":{"const":"query_prefix_states"},"source_population":{"const":"prefix_state_rows"},"output_population":{"const":"prefix_state_rows"},"disposition":{"const":"new_p2_v1_source_schema_required"},"source_readiness":{"const":"row_schema_required_before_implementation"}}}
    },
    {
      "if": {"properties": {"unit_id": {"const": "TOOL-09"}}, "required": ["unit_id"]},
      "then": {"properties": {"name":{"const":"query_as_states"},"source_population":{"const":"asn_state_rows"},"output_population":{"const":"asn_state_rows"},"disposition":{"const":"new_p2_v1_source_schema_required"},"source_readiness":{"const":"row_schema_required_before_implementation"}}}
    },
    {
      "if": {"properties": {"unit_id": {"const": "TOOL-10"}}, "required": ["unit_id"]},
      "then": {"properties": {"name":{"const":"query_new_prefix_states"},"source_population":{"const":"new_prefix_state_rows"},"output_population":{"const":"new_prefix_state_rows"},"disposition":{"const":"new_p2_v1_homogeneous_source_schema_required"},"source_readiness":{"const":"homogeneous_row_schema_required_before_implementation"}}}
    },
    {
      "if": {"properties": {"unit_id": {"const": "TOOL-11"}}, "required": ["unit_id"]},
      "then": {
        "required": ["direction_identity_contract", "contains_asn_filter_contract", "state_time_semantics", "active_path_rule", "invisible_path_rule", "output_row_constraints"],
        "properties": {
          "source_population": {"const": "materialized_route_state_rows_at_exact_time"},
          "output_population": {"const": "materialized_route_state_rows_at_exact_time"},
          "name": {"const": "query_materialized_route_states_at_time"},
          "disposition": {"const": "new_p2_v1_source_view_required"},
          "source_readiness": {"const": "materialized_view_and_projection_receipt_required_before_implementation"}
        }
      }
    },
    {
      "if": {"properties": {"unit_id": {"const": "TOOL-12"}}, "required": ["unit_id"]},
      "then": {"required":["association_population_domain","direction_identity_contract","native_filter_contract","output_row_constraints"],"properties": {"name":{"const":"query_window_path_associations"},"source_population":{"const":"window_path_association_evidence_rows"},"output_population":{"const":"window_path_association_evidence_rows"},"disposition":{"const":"new_p2_v1_source_schema_required"},"source_readiness":{"const":"association_row_and_path_quality_schema_required_before_implementation"},"time_semantics":{"const":"window_level_association_not_path_at_time"},"forbidden_conclusions":{"contains":{"const":"path_active_at_time"}}}}
    },
    {
      "if": {"properties": {"unit_id": {"const": "TOOL-13"}}, "required": ["unit_id"]},
      "then": {"required":["source_population_contract","source_adapter_mapping","withdraw_rule","output_row_constraints"],"properties": {"name":{"const":"query_route_events"},"source_population":{"const":"route_event_rows"},"output_population":{"const":"route_event_rows"},"disposition":{"const":"deferred_p2_1"},"source_readiness":{"const":"deferred_registry_and_manifest_binding_required"}}}
    }
  ],
  "additionalProperties": false
}
