{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domeye.example/contracts/agent/country-outage-p2-s1/investigation-plan.schema.json",
  "title": "RRC25 国家中断组合式调查计划合同",
  "description": "设计期机器合同。计划定义、调查快照与节点执行修订彼此独立；组合只能发生在计划 DAG。",
  "x-contract-metadata": {
    "artifact_id": "country-outage-p2-s1d4-investigation-plan-20260812",
    "stage": "S1D-4",
    "status": "design_contract_only"
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_definition",
    "investigation_snapshot",
    "design_boundary"
  ],
  "properties": {
