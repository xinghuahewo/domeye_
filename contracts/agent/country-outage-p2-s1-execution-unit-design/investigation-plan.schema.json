        "publication_id",
        "publication_revision",
        "publication_digest",
        "collector_id",
        "cohort_id",
        "cohort_digest",
        "window_start_utc",
        "window_end_utc",
        "data_through_utc",
        "finality",
        "registry_snapshot_id",
        "registry_snapshot_digest",
        "binding_generation",
        "binding_digest"
      ],
      "properties": {
        "incident_id": {"$ref": "#/$defs/nonEmptyString"},
        "publication_id": {"$ref": "#/$defs/nonEmptyString"},
        "publication_revision": {"type": "integer", "minimum": 1},
        "publication_digest": {"$ref": "#/$defs/sha256"},
        "collector_id": {"const": "rrc25"},
        "cohort_id": {"$ref": "#/$defs/nonEmptyString"},
        "cohort_digest": {"$ref": "#/$defs/sha256"},
        "window_start_utc": {"$ref": "#/$defs/utcTimestamp"},
        "window_end_utc": {"$ref": "#/$defs/utcTimestamp"},
        "data_through_utc": {"$ref": "#/$defs/utcTimestamp"},
        "finality": {"enum": ["event_end_unknown", "event_end_known"]},
        "registry_snapshot_id": {"type": "string", "pattern": "^registry-snapshot-sha256:[0-9a-f]{64}$"},
        "registry_snapshot_digest": {"$ref": "#/$defs/prefixedSha256"},
        "binding_generation": {"type": "integer", "minimum": 1},
        "binding_digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "executionUnitRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit_id",
        "unit_kind",
        "unit_version",
        "contract_digest",
        "unit_implementation_digest",
        "unit_semantic_digest",
        "atomic_capability_id",
        "atomic_capability_version",
        "capability_contract_digest"
      ],
      "properties": {
        "unit_id": {
          "type": "string",
          "pattern": "^(PLAN-CAP-[0-9]{2}|(TOOL|OP|GATE|BOUNDARY|RENDERER|DELIVERY)-[0-9]{2})$"
        },
        "unit_kind": {
          "enum": ["plan_capability", "tool", "operator", "gate", "boundary", "renderer", "delivery"]
