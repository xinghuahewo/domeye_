        "atomic_capability_version": {"$ref": "#/$defs/nonEmptyString"},
        "capability_contract_digest": {"$ref": "#/$defs/prefixedSha256"}
      }
    },
    "planNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "execution_unit",
        "depends_on",
        "dependency_mode",
        "requiredness",
        "wave",
        "input_bindings",
        "parameters_digest",
        "expected_output_schema_ref",
        "completeness_requirement",
        "incomplete_input_policy",
        "budget_allocation",
        "permission_scope_id",
        "cancellation_policy"
      ],
      "properties": {
        "node_id": {"$ref": "#/$defs/nonEmptyString"},
        "execution_unit": {"$ref": "#/$defs/executionUnitRef"},
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nonEmptyString"}
        },
        "dependency_mode": {"enum": ["hard", "soft"]},
        "requiredness": {"enum": ["required", "optional", "deferred", "boundary_only"]},
        "wave": {"type": "integer", "minimum": 0},
        "input_bindings": {
          "type": "array",
          "items": {"$ref": "#/$defs/inputBinding"}
        },
        "parameters_digest": {"$ref": "#/$defs/sha256"},
        "expected_output_schema_ref": {"type": "string", "format": "uri-reference"},
        "completeness_requirement": {
          "enum": ["complete", "partial_page_allowed", "source_incomplete_allowed"]
        },
        "incomplete_input_policy": {
          "enum": ["fail_closed", "operator_declared_monotonic_lower_bound"]
        },
        "monotonicity_contract_ref": {
          "oneOf": [
            {"type": "string", "format": "uri-reference"},
            {"type": "null"}
          ]
        },
        "budget_allocation": {"$ref": "#/$defs/budget"},
        "permission_scope_id": {"$ref": "#/$defs/nonEmptyString"},
        "cancellation_policy": {"enum": ["cooperative", "non_interruptible_prepare_then_abort_commit"]}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "incomplete_input_policy": {"const": "operator_declared_monotonic_lower_bound"}
            },
            "required": ["incomplete_input_policy"]
          },
          "then": {
            "required": ["monotonicity_contract_ref"],
            "properties": {
              "execution_unit": {
                "properties": {"unit_kind": {"const": "operator"}},
                "required": ["unit_kind"]
              },
              "monotonicity_contract_ref": {"type": "string", "format": "uri-reference"}
            }
          },
          "else": {
            "properties": {"monotonicity_contract_ref": {"type": "null"}}
          }
        }
      ]
    },
    "inputBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_name", "source_kind", "source_ref", "source_digest", "source_artifact_digest"],
      "properties": {
        "input_name": {"$ref": "#/$defs/nonEmptyString"},
        "source_kind": {"enum": ["identity", "node_result", "result_set", "operator_receipt", "user_parameter"]},
        "source_ref": {"$ref": "#/$defs/nonEmptyString"},
        "source_digest": {"$ref": "#/$defs/sha256"},
        "source_artifact_digest": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
      },
      "allOf": [
        {
          "if": {
            "properties": {"source_kind": {"enum": ["node_result", "result_set", "operator_receipt"]}},
            "required": ["source_kind"]
          },
          "then": {"properties": {"source_artifact_digest": {"$ref": "#/$defs/sha256"}}},
          "else": {"properties": {"source_artifact_digest": {"type": "null"}}}
        }
      ]
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_wall_ms", "max_rows", "max_bytes", "max_cost_amount", "cost_currency"],
      "properties": {
        "max_wall_ms": {"type": "integer", "minimum": 1},
        "max_rows": {"type": "integer", "minimum": 0},
        "max_bytes": {"type": "integer", "minimum": 0},
        "max_cost_amount": {"type": "number", "minimum": 0},
        "cost_currency": {"type": "string", "pattern": "^[A-Z]{3}$"}
      }
    },
    "planDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plan_id",
        "plan_revision",
        "parent_plan_revision",
        "plan_state",
        "goal_digest",
        "identity",
        "registry_snapshot_id",
        "registry_snapshot_digest",
        "nodes",
        "dag_digest",
        "budget",
        "answer_execution_policy",
        "permission_set_digest",
        "admission_receipt_digest"
      ],
      "properties": {
        "plan_id": {"$ref": "#/$defs/nonEmptyString"},
        "plan_revision": {"type": "integer", "minimum": 1},
        "parent_plan_revision": {"oneOf": [{"type": "integer", "minimum": 1}, {"type": "null"}]},
        "plan_state": {"enum": ["draft", "admitted", "rejected", "superseded"]},
        "goal_digest": {"$ref": "#/$defs/sha256"},
        "identity": {"$ref": "#/$defs/identityBinding"},
        "registry_snapshot_id": {"type": "string", "pattern": "^registry-snapshot-sha256:[0-9a-f]{64}$"},
        "registry_snapshot_digest": {"$ref": "#/$defs/prefixedSha256"},
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/planNode"}
        },
        "dag_digest": {"$ref": "#/$defs/sha256"},
        "budget": {"$ref": "#/$defs/budget"},
        "answer_execution_policy": {"$ref": "#/$defs/answerExecutionPolicy"},
        "permission_set_digest": {"$ref": "#/$defs/sha256"},
        "admission_receipt_digest": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
      },
      "allOf": [
        {
          "if": {
            "properties": {"plan_revision": {"const": 1}},
            "required": ["plan_revision"]
          },
          "then": {"properties": {"parent_plan_revision": {"type": "null"}}},
          "else": {"properties": {"parent_plan_revision": {"type": "integer", "minimum": 1}}}
        },
        {
          "if": {
            "properties": {"plan_state": {"const": "admitted"}},
            "required": ["plan_state"]
          },
          "then": {"properties": {"admission_receipt_digest": {"$ref": "#/$defs/sha256"}}}
        }
      ]
    },
    "answerExecutionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["teacher_required", "mode", "authorization_digest"],
      "properties": {
        "teacher_required": {"type": "boolean"},
        "mode": {"enum": ["sol_teacher_then_ds_student", "ds_unaligned_explicitly_authorized"]},
        "authorization_digest": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
      },
      "allOf": [
        {
          "if": {"properties": {"teacher_required": {"const": true}}, "required": ["teacher_required"]},
          "then": {
            "properties": {
              "mode": {"const": "sol_teacher_then_ds_student"},
              "authorization_digest": {"type": "null"}
            }
          },
          "else": {
            "properties": {
              "mode": {"const": "ds_unaligned_explicitly_authorized"},
              "authorization_digest": {"$ref": "#/$defs/sha256"}
            }
          }
        }
      ]
    },
    "nodeExecutionRevision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "execution_revision",
        "parent_execution_revision",
        "state",
        "idempotency_key",
        "input_digest",
        "result_digest",
        "receipt_digest",
        "failure_code"
      ],
      "properties": {
        "node_id": {"$ref": "#/$defs/nonEmptyString"},
        "execution_revision": {"type": "integer", "minimum": 1},
        "parent_execution_revision": {"oneOf": [{"type": "integer", "minimum": 1}, {"type": "null"}]},
        "state": {
          "enum": ["pending", "ready", "running", "prepared", "committed", "failed", "cancelled", "skipped_dependency_failed", "reused"]
        },
        "idempotency_key": {"$ref": "#/$defs/nonEmptyString"},
        "input_digest": {"$ref": "#/$defs/sha256"},
        "result_digest": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "receipt_digest": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "failure_code": {"oneOf": [{"$ref": "#/$defs/nonEmptyString"}, {"type": "null"}]}
      },
      "allOf": [
        {
          "if": {
            "properties": {"execution_revision": {"const": 1}},
            "required": ["execution_revision"]
          },
          "then": {"properties": {"parent_execution_revision": {"type": "null"}}},
          "else": {"properties": {"parent_execution_revision": {"type": "integer", "minimum": 1}}}
        },
        {
          "if": {
            "properties": {"state": {"enum": ["committed", "reused"]}},
            "required": ["state"]
          },
          "then": {
            "properties": {
              "result_digest": {"$ref": "#/$defs/sha256"},
              "receipt_digest": {"$ref": "#/$defs/sha256"},
              "failure_code": {"type": "null"}
            }
          }
        },
        {
          "if": {
            "properties": {"state": {"enum": ["failed", "cancelled", "skipped_dependency_failed"]}},
            "required": ["state"]
          },
          "then": {
            "properties": {
              "result_digest": {"type": "null"},
              "receipt_digest": {"$ref": "#/$defs/sha256"},
              "failure_code": {"$ref": "#/$defs/nonEmptyString"}
            }
          }
        },
        {
          "if": {
            "properties": {"state": {"enum": ["pending", "ready", "running", "prepared"]}},
            "required": ["state"]
          },
          "then": {
            "properties": {
              "result_digest": {"type": "null"},
              "receipt_digest": {"type": "null"},
              "failure_code": {"type": "null"}
            }
          }
        }
      ]
    },
    "investigationSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "investigation_id",
        "investigation_revision",
        "parent_investigation_revision",
        "plan_id",
        "plan_revision",
        "status",
        "node_execution_revisions",
        "evidence_graph_revision",
        "snapshot_digest"
      ],
      "properties": {
        "investigation_id": {"$ref": "#/$defs/nonEmptyString"},
        "investigation_revision": {"type": "integer", "minimum": 1},
        "parent_investigation_revision": {"oneOf": [{"type": "integer", "minimum": 1}, {"type": "null"}]},
        "plan_id": {"$ref": "#/$defs/nonEmptyString"},
        "plan_revision": {"type": "integer", "minimum": 1},
        "status": {"enum": ["pending", "running", "cancel_requested", "completed", "partially_completed", "failed", "cancelled"]},
        "node_execution_revisions": {
          "type": "array",
          "items": {"$ref": "#/$defs/nodeExecutionRevision"}
        },
        "evidence_graph_revision": {"oneOf": [{"type": "integer", "minimum": 1}, {"type": "null"}]},
        "snapshot_digest": {"$ref": "#/$defs/sha256"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"investigation_revision": {"const": 1}},
            "required": ["investigation_revision"]
          },
          "then": {"properties": {"parent_investigation_revision": {"type": "null"}}},
          "else": {"properties": {"parent_investigation_revision": {"type": "integer", "minimum": 1}}}
        },
        {
          "if": {
            "properties": {"status": {"enum": ["completed", "partially_completed"]}},
            "required": ["status"]
          },
          "then": {"properties": {"evidence_graph_revision": {"type": "integer", "minimum": 1}}}
        }
      ]
    },
    "designBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["design_only", "runtime_implemented", "production_deployed"],
      "properties": {
        "design_only": {"const": true},
        "runtime_implemented": {"const": false},
        "production_deployed": {"const": false}
      }
    }
  },
  "x-plan-state-contract": {
    "plan_definition_transitions": [
      "draft->admitted",
      "draft->rejected",
      "admitted->superseded"
    ],
    "investigation_transitions": [
      "pending->running",
      "running->cancel_requested",
      "running->completed",
      "running->partially_completed",
      "running->failed",
      "running->cancelled",
      "cancel_requested->cancelled",
      "cancel_requested->partially_completed",
      "completed->completed(plan_revision_changed)",
      "partially_completed->partially_completed(plan_revision_changed)"
    ],
    "terminal_status_repetition_requires_next_plan_revision": true,
    "node_transitions": [
      "pending->ready",
      "ready->running",
      "running->prepared",
      "prepared->committed",
      "pending->skipped_dependency_failed",
      "ready->cancelled",
      "running->cancelled",
      "running->failed",
      "prepared->cancelled",
      "pending->reused",
      "ready->reused"
    ]
  },
  "x-revision-contract": {
    "plan_revision_semantic": "计划定义修订；参数、权限、降级策略或DAG变化必须新建并重新准入",
    "investigation_revision_semantic": "一次已提交调查快照；每次状态变化创建新修订，不覆盖历史",
    "execution_revision_semantic": "单节点运行修订；同参数局部重跑只新建execution_revision与investigation_revision",
    "same_parameter_rerun_changes_plan_revision": false,
    "parameter_or_permission_change_requires_new_plan_revision": true,
    "history_overwrite_forbidden": true
  },
  "x-composition-contract": {
    "composition_location": "InvestigationPlan",
    "one_node_one_atomic_execution_unit": true,
    "embedded_execution_units_forbidden": true,
    "fallback_units_forbidden": true,
    "internal_dag_forbidden": true,
    "p2_v1_deferred_units": ["TOOL-13", "OP-34", "PLAN-CAP-02"],
    "p2_v1_deferred_units_admission_forbidden": true,
    "hard_dependency_failure_propagates_only_to_dependents": true,
    "independent_branch_may_continue": true,
    "required_identity_failure_stops_before_other_units": true
  },
  "x-incomplete-input-contract": {
    "default": "fail_closed",
    "lower_bound_requires_registered_operator_monotonicity_contract": true,
    "preview_is_not_completeness": true
  },
  "x-digest-normalization-contract": {
    "data_and_evidence_digest_format": "lowercase_hex64",
    "governance_registry_and_admission_digest_format": "sha256:lowercase_hex64",
    "governance_digest_value_projection": "remove_exact_sha256_prefix_only",
    "projected_governance_digest_must_equal_bound_data_digest_when_same_artifact": true,
