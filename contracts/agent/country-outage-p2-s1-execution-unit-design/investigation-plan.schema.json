    "input_name_must_be_registered_input_schema_property": true,
    "input_name_must_have_bound_parameter_value": true,
    "duplicate_input_name_forbidden": true,
    "every_bound_parameter_has_exactly_one_input_binding": true,
    "source_digest_recipe": [
