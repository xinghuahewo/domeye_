{
  "schema_version": "country_outage_p1_runtime_policy_v2",
  "policy_revision": "p1-runtime-v2-s0-20260809",
  "scope": {"event_type": "country_outage", "collector_id": "rrc25", "mode": "read_only"},
  "principal_permissions": {
    "required": ["country_outage:read"],
    "denied_operations": ["write", "generate_report", "external_fetch", "cross_event_investigation", "root_cause_analysis"]
  },
  "grounding": {
    "allowed_execution_units": ["TOOL-01", "TOOL-02", "TOOL-03", "TOOL-04", "TOOL-05", "TOOL-06", "OP-01", "OP-02", "OP-03"],
    "allowed_decisions": ["supported", "partial", "clarify", "unsupported", "invalid_data"],
    "hard_gates": ["goal_preserved", "capability_selected", "event_capability_negotiated", "principal_authorized", "identity_exact", "parameter_valid", "dependency_closed", "oracle_covered", "evidence_contract_closed", "evidence_reference_resolved"],
    "invalid_node_action": "reject_entire_grounding_before_execution",
    "unsupported_goal_action": "preserve_goal_and_return_boundary_without_execution"
  },
  "grounding_validator": {
    "contract": "semantic-plan.schema.json#x-host-invariants",
    "required_invariants": ["GND-01", "GND-02", "GND-03", "GND-04", "GND-05", "GND-06", "GND-07", "GND-08", "GND-09", "GND-10", "GND-11", "GND-12", "GND-13"],
    "validation_order": ["schema", "parameter_schema_valid", "goal_decision_bijection", "reference_closure", "dependency_dag", "input_source_bijection", "capability_unit_mapping", "event_capability_negotiation", "permission", "oracle_coverage", "decision_node_invariant", "identity", "evidence_reference_resolution"],
    "all_checks_pass_before_execution": true,
    "illegal_node_may_reach_executor": false,
    "illegal_node_may_publish_fact": false,
    "illegal_node_may_commit_state": false
  },
  "host_result_codes": [
    "capability_unavailable", "parameter_schema_invalid", "metric_missing", "metric_value_unknown",
    "peak_time_unknown", "recovery_not_observed", "rrc25_control_plane_is_not_user_evidence",
    "peak_not_recovery_or_cause", "population_semantics_mismatch", "address_population_not_user_population",
    "unit_mismatch", "new_prefix_not_user_evidence", "path_association_not_dependency_or_cause",
    "sample_field_unknown", "full_path_evidence_unavailable", "bounded_sample_not_full_topology",
    "data_implementation_is_not_web_release_identity", "extrema_cannot_establish_recovery",
    "missing_input", "timeline_node_missing", "peak_nodes_unavailable", "timeline_has_no_causal_edges",
    "evidence_reference_not_resolved", "evidence_value_conflict"
  ],
  "event_binding_protocol": {
    "mode": "two_phase",
    "phase_1": "在当前完整 identity 下仅允许 TOOL-01 解析用户提供的目标引用；不生成目标事件事实",
    "phase_2": "TOOL-01 验证目标 event_type/incident/publication/revision/collector/capabilities 后，以目标完整 identity 新建 bound GroundingPlan",
    "failed_resolution": "保留旧 binding、EvidenceState 和可执行 DialogState",
    "implicit_latest_switch": "forbidden"
  },
  "boundary_goal_kinds": {
    "cause_or_responsibility": {"capability_id": "CAP-022", "decision": "unsupported", "reason_code": "rrc25_cannot_establish_cause_or_responsibility"},
    "real_user_or_national_impact": {"capability_id": "CAP-023", "decision": "unsupported", "reason_code": "rrc25_control_plane_is_not_user_or_national_impact_evidence"},
    "economic_impact": {"capability_id": "CAP-023", "decision": "unsupported", "reason_code": "rrc25_has_no_economic_impact_evidence"},
    "dns_http_traffic": {"capability_id": "CAP-024", "decision": "unsupported", "reason_code": "external_data_plane_source_not_in_p1"},
    "external_evidence": {"capability_id": "CAP-021", "decision": "unsupported", "reason_code": "external_evidence_not_configured"},
    "cross_event_investigation": {"capability_id": "CAP-025", "decision": "unsupported", "reason_code": "compound_investigation_belongs_to_p2"},
    "bgp_update_activity": {"capability_id": "CAP-026", "decision": "unsupported", "reason_code": "update_track_unavailable_not_zero"},
    "trend_analysis": {"capability_id": "CAP-015", "decision": "unsupported", "reason_code": "trend_publication_unavailable"},
    "unknown_goal": {"capability_id": null, "decision": "clarify", "reason_code": "required_goal_or_entity_not_safely_groundable"}
  },
  "fact_publication": {
    "sources": ["resolution", "overview", "series", "asns", "paths", "audit", "derived"],
    "model_generated_values": "forbidden",
    "required_fields": ["evidence_ref", "publication_id", "revision", "collector_id", "unit_or_explicit_not_applicable"],
    "identity_conflict_action": "rollback_entire_turn",
    "partial_tool_result_action": "do_not_publish_unvalidated_part"
  },
  "missing_semantics": {
    "null": "字段存在但值未观测或未知",
    "unknown": "当前证据无法确定",
    "unavailable": "能力或轨道在当前 publication 不可用",
    "not_configured": "提供方未配置",
    "empty": "合法查询结果人口为空",
    "zero": "已观测且数值为 0"
  },
  "state_transaction": {
    "evidence_state_owner": "host",
    "dialog_state_owner": "validated_runtime",
    "commit_after": ["user_goal_schema", "grounding_legality", "authorization", "tool_identity", "answer_evidence", "boundary_validation"],
    "unsupported_writes_executable_slots": false,
    "failed_writes_executable_slots": false,
    "shared_identity_conflict": "rollback_entire_turn",
    "revision_drift": "keep_old_state_and_require_rebind",
    "event_switch": "explicitly_clear_event_scoped_dialog_and_evidence_state"
  },
  "audit": {
    "record": ["request_identity", "user_goal_plan_revision", "grounding_plan_revision", "execution_unit_versions", "decision_per_goal", "result_status", "evidence_refs", "state_transition", "failure_codes"],
    "record_hidden_chain_of_thought": false,
    "redact_credentials": true
  }
}
