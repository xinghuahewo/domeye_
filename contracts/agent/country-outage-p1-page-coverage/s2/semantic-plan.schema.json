{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domeye.local/contracts/country-outage-p1-runtime-v2/semantic-plan.schema.json",
  "title": "国家中断 P1 Runtime v2 语义计划合同",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "user_goal_plan", "grounding_plan"],
  "properties": {
    "schema_version": {"const": "country_outage_p1_semantic_plan_v2"},
    "user_goal_plan": {"$ref": "#/$defs/userGoalPlan"},
    "grounding_plan": {"$ref": "#/$defs/groundingPlan"}
  },
  "x-host-invariants": [
    {"invariant_id": "GND-01", "error_code": "goal_reference_not_closed", "rule": "每个 UserGoal 恰好有一个 decision；不得出现额外或丢失 goal_id"},
    {"invariant_id": "GND-02", "error_code": "node_reference_not_closed", "rule": "decision.node_ids、node.goal_id、depends_on 必须引用同一计划内存在对象"},
    {"invariant_id": "GND-03", "error_code": "dependency_cycle", "rule": "depends_on 图必须无环，且节点按拓扑序执行"},
    {"invariant_id": "GND-04", "error_code": "input_source_not_closed", "rule": "每个 inputs 键恰好有一个 input_sources 来源，且不得声明额外来源"},
    {"invariant_id": "GND-05", "error_code": "capability_unit_mismatch", "rule": "capability_ids 必须是该 execution_unit 在 Capability Catalog 与 Typed Tool Contract 的交集"},
    {"invariant_id": "GND-06", "error_code": "event_capability_not_negotiated", "rule": "执行前逐节点核对 Capability Catalog：supported 必须满足 required_for_supported；partial 必须满足 sufficient_for_partial；派生算子递归继承源 Tool 的协商结果"},
    {"invariant_id": "GND-07", "error_code": "permission_denied", "rule": "authorization_scope 与 principal 权限相交后必须包含 country_outage:read"},
    {"invariant_id": "GND-08", "error_code": "oracle_not_covered", "rule": "每个执行节点的 Capability×执行单元必须存在已通过的 normal 与五类失败 Oracle"},
    {"invariant_id": "GND-09", "error_code": "decision_node_invariant", "rule": "supported/partial 至少一个节点；clarify/unsupported/invalid_data 零节点"},
    {"invariant_id": "GND-10", "error_code": "identity_conflict", "rule": "plan、Tool 结果、EvidenceState 与回答的完整身份必须一致；冲突整轮回滚"},
    {"invariant_id": "GND-11", "error_code": "event_switch_requires_two_phase_binding", "rule": "事件切换先在 current identity 下只执行 TOOL-01；解析成功后新建 target bound plan，解析前不得生成目标事件事实节点"},
    {"invariant_id": "GND-12", "error_code": "parameter_schema_invalid", "rule": "GroundingPlan 参数必须同时通过执行单元 Schema 与逐 Capability 参数 Schema；派生节点只保存已验证依赖引用。宿主在依赖完成后物化完整 identity/value/unit/evidence，并再次通过对应 execution_unit 的执行请求 Schema；任一失败均不得进入执行器"},
    {"invariant_id": "GND-13", "error_code": "evidence_reference_not_resolved", "rule": "宿主发布派生事实前，必须把每个 evidence_ref 解析到本轮已验证依赖输出中的真实字段，并核对完整 source identity；无法解析、越出依赖或身份不一致均回滚整轮"}
  ],
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding_phase", "event_type", "incident_id", "publication_id", "revision", "collector_id", "cohort_id", "country_code", "window_start_utc", "window_end_utc", "data_through", "is_final_in_data_range", "lifecycle_state", "observation_state", "capabilities"],
      "properties": {
        "binding_phase": {"enum": ["bound", "resolving_target"]},
        "event_type": {"const": "country_outage"},
        "incident_id": {"type": "string", "minLength": 1},
        "publication_id": {"type": "string", "minLength": 1},
        "revision": {"type": "integer", "minimum": 1},
        "collector_id": {"const": "rrc25"},
        "cohort_id": {"type": "string", "minLength": 1},
        "country_code": {"type": "string", "pattern": "^[A-Z]{2}$"},
        "window_start_utc": {"type": "string", "format": "date-time"},
        "window_end_utc": {"type": "string", "format": "date-time"},
        "data_through": {"type": ["string", "null"], "format": "date-time"},
        "is_final_in_data_range": {"type": "boolean"},
        "lifecycle_state": {"type": "string", "minLength": 1},
        "observation_state": {"type": "string", "minLength": 1},
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": ["overview", "event_series", "affected_as", "path_downstreams", "full_path_evidence"],
          "properties": {
            "overview": {"enum": ["available", "unavailable"]},
            "event_series": {"enum": ["available", "unavailable"]},
            "affected_as": {"enum": ["available", "unavailable"]},
            "path_downstreams": {"enum": ["available", "unavailable"]},
            "full_path_evidence": {"enum": ["audit_only", "unavailable"]}
          }
        }
      }
    },
    "entityValue": {"type": ["string", "number", "boolean", "null"]},
    "goal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goal_id", "requested_goal", "normalized_kind", "entities", "references", "ambiguity", "context_dependencies"],
      "properties": {
        "goal_id": {"type": "string", "pattern": "^goal-[1-9][0-9]*$"},
        "requested_goal": {"type": "string", "minLength": 1, "description": "开放用户目标原文或忠实释义，不受工具白名单裁剪"},
        "normalized_kind": {"type": "string", "minLength": 1, "description": "可扩展归一标签；unknown 仍保留 requested_goal"},
        "entities": {"type": "object", "additionalProperties": {"$ref": "#/$defs/entityValue"}},
        "references": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "ambiguity": {"enum": ["none", "non_blocking", "blocking"]},
        "context_dependencies": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "stateProposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inherit", "set", "clear", "reason_codes"],
      "properties": {
        "inherit": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "set": {"type": "object", "additionalProperties": {"$ref": "#/$defs/entityValue"}},
        "clear": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "reason_codes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "userGoalPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan_revision", "original_question", "goals", "state_proposal", "planner_identity", "confidence"],
      "properties": {
        "plan_revision": {"const": "user-goal-plan-v2"},
        "original_question": {"type": "string", "minLength": 1},
        "goals": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"$ref": "#/$defs/goal"}},
        "state_proposal": {"$ref": "#/$defs/stateProposal"},
        "planner_identity": {"type": "string", "minLength": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "inputSource": {"enum": ["binding", "user_goal", "dialog_state", "tool_result", "policy_default"]},
    "inputSources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "event_reference": {"$ref": "#/$defs/inputSource"}, "expected_publication_id": {"$ref": "#/$defs/inputSource"}, "expected_revision": {"$ref": "#/$defs/inputSource"},
        "incident_id": {"$ref": "#/$defs/inputSource"}, "publication_id": {"$ref": "#/$defs/inputSource"}, "revision": {"$ref": "#/$defs/inputSource"},
        "metrics": {"$ref": "#/$defs/inputSource"}, "asn": {"$ref": "#/$defs/inputSource"}, "query": {"$ref": "#/$defs/inputSource"}, "classification": {"$ref": "#/$defs/inputSource"}, "sort": {"$ref": "#/$defs/inputSource"}, "page": {"$ref": "#/$defs/inputSource"}, "page_size": {"$ref": "#/$defs/inputSource"},
        "affected_asn": {"$ref": "#/$defs/inputSource"}, "scope": {"$ref": "#/$defs/inputSource"},
        "source_node_id": {"$ref": "#/$defs/inputSource"}, "metric": {"$ref": "#/$defs/inputSource"}, "tie_policy": {"$ref": "#/$defs/inputSource"},
        "ipv4_extrema_node_id": {"$ref": "#/$defs/inputSource"}, "ipv6_extrema_node_id": {"$ref": "#/$defs/inputSource"},
        "source_node_ids": {"$ref": "#/$defs/inputSource"}, "lifecycle_state": {"$ref": "#/$defs/inputSource"}
      }
    },
    "nodeBase": {
      "type": "object",
      "required": ["node_id", "goal_id", "execution_unit", "capability_ids", "inputs", "input_sources", "depends_on", "expected_evidence_sources"],
      "properties": {
        "node_id": {"type": "string", "pattern": "^node-[1-9][0-9]*$"},
        "goal_id": {"type": "string", "pattern": "^goal-[1-9][0-9]*$"},
        "input_sources": {"$ref": "#/$defs/inputSources"},
        "depends_on": {"type": "array", "items": {"type": "string", "pattern": "^node-[1-9][0-9]*$"}, "uniqueItems": true},
        "expected_evidence_sources": {"type": "array", "minItems": 1, "items": {"enum": ["resolution", "overview", "series", "asns", "paths", "audit", "derived"]}, "uniqueItems": true}
      }
    },
    "bindingInputs": {"type": "object", "additionalProperties": false, "required": ["event_reference"], "properties": {"event_reference": {"type": "string", "minLength": 1, "maxLength": 1024}, "expected_publication_id": {"type": ["string", "null"]}, "expected_revision": {"type": ["integer", "null"], "minimum": 1}}},
    "identityInputs": {"type": "object", "additionalProperties": false, "required": ["incident_id", "publication_id", "revision"], "properties": {"incident_id": {"type": "string", "minLength": 1}, "publication_id": {"type": "string", "minLength": 1}, "revision": {"type": "integer", "minimum": 1}}},
    "seriesInputs": {"type": "object", "additionalProperties": false, "required": ["incident_id", "publication_id", "revision", "metrics"], "properties": {"incident_id": {"type": "string", "minLength": 1}, "publication_id": {"type": "string", "minLength": 1}, "revision": {"type": "integer", "minimum": 1}, "metrics": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["interrupted_prefix_count", "completely_interrupted_prefix_count", "invisible_direction_count", "affected_asn_count", "route_interrupted_asn_count", "fixed_visible_ipv4_address_count", "fixed_visible_ipv6_slash48_count", "new_cumulative_ipv4_prefix_count", "new_cumulative_ipv4_address_count", "new_cumulative_ipv6_prefix_count", "new_cumulative_ipv6_slash48_count", "new_visible_ipv4_prefix_count", "new_visible_ipv4_address_count", "new_visible_ipv6_prefix_count", "new_visible_ipv6_slash48_count"]}}}},
    "seriesInputsCap006": {"allOf": [{"$ref": "#/$defs/seriesInputs"}, {"type": "object", "properties": {"metrics": {"const": ["fixed_visible_ipv4_address_count"]}}}]},
    "seriesInputsCap007": {"allOf": [{"$ref": "#/$defs/seriesInputs"}, {"type": "object", "properties": {"metrics": {"const": ["fixed_visible_ipv6_slash48_count"]}}}]},
    "seriesInputsCap008": {"allOf": [{"$ref": "#/$defs/seriesInputs"}, {"type": "object", "properties": {"metrics": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["new_cumulative_ipv4_prefix_count", "new_cumulative_ipv4_address_count", "new_cumulative_ipv6_prefix_count", "new_cumulative_ipv6_slash48_count", "new_visible_ipv4_prefix_count", "new_visible_ipv4_address_count", "new_visible_ipv6_prefix_count", "new_visible_ipv6_slash48_count"]}}}}]},
    "seriesInputsCap009": {"$ref": "#/$defs/seriesInputs"},
    "asnInputs": {"type": "object", "additionalProperties": false, "required": ["incident_id", "publication_id", "revision", "query", "classification", "sort", "page", "page_size"], "properties": {"incident_id": {"type": "string"}, "publication_id": {"type": "string"}, "revision": {"type": "integer", "minimum": 1}, "asn": {"type": ["integer", "null"], "minimum": 1, "maximum": 4294967295}, "query": {"type": "string", "maxLength": 128}, "classification": {"enum": ["all", "affected", "route_interrupted"]}, "sort": {"enum": ["default", "asn_asc"]}, "page": {"type": "integer", "minimum": 1}, "page_size": {"type": "integer", "minimum": 1, "maximum": 60}}},
    "asnListInputs": {"allOf": [{"$ref": "#/$defs/asnInputs"}, {"type": "object", "not": {"required": ["asn"]}}]},
    "asnDetailInputs": {"allOf": [{"$ref": "#/$defs/asnInputs"}, {"type": "object", "required": ["asn"], "properties": {"asn": {"type": "integer", "minimum": 1, "maximum": 4294967295}}}]},
    "pathInputs": {"type": "object", "additionalProperties": false, "required": ["incident_id", "publication_id", "revision", "affected_asn", "scope", "query", "page", "page_size"], "properties": {"incident_id": {"type": "string"}, "publication_id": {"type": "string"}, "revision": {"type": "integer", "minimum": 1}, "affected_asn": {"type": ["integer", "null"], "minimum": 1, "maximum": 4294967295}, "scope": {"enum": ["all", "concurrent"]}, "query": {"type": "string", "maxLength": 128}, "page": {"type": "integer", "minimum": 1}, "page_size": {"type": "integer", "minimum": 1, "maximum": 60}}},
    "extremaInputs": {
      "type": "object", "additionalProperties": false, "required": ["source_node_id", "metric", "tie_policy"],
      "properties": {"source_node_id": {"type": "string", "pattern": "^node-[1-9][0-9]*$"}, "metric": {"enum": ["interrupted_prefix_count", "completely_interrupted_prefix_count", "invisible_direction_count", "affected_asn_count", "route_interrupted_asn_count", "fixed_visible_ipv4_address_count", "fixed_visible_ipv6_slash48_count", "new_cumulative_ipv4_prefix_count", "new_cumulative_ipv4_address_count", "new_cumulative_ipv6_prefix_count", "new_cumulative_ipv6_slash48_count", "new_visible_ipv4_prefix_count", "new_visible_ipv4_address_count", "new_visible_ipv6_prefix_count", "new_visible_ipv6_slash48_count"]}, "tie_policy": {"const": "first_observed_occurrence"}}
    },
    "compareInputs": {"type": "object", "additionalProperties": false, "required": ["ipv4_extrema_node_id", "ipv6_extrema_node_id"], "properties": {"ipv4_extrema_node_id": {"type": "string", "pattern": "^node-[1-9][0-9]*$"}, "ipv6_extrema_node_id": {"type": "string", "pattern": "^node-[1-9][0-9]*$"}}},
    "timelineInputs": {"type": "object", "additionalProperties": false, "required": ["source_node_ids", "lifecycle_state"], "properties": {"source_node_ids": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "pattern": "^node-[1-9][0-9]*$"}}, "lifecycle_state": {"type": "string", "minLength": 1}}},
    "node": {
      "oneOf": [
        {"allOf": [{"$ref": "#/$defs/nodeBase"}, {"type": "object", "properties": {"execution_unit": {"const": "TOOL-01"}, "capability_ids": {"const": ["CAP-001"]}, "inputs": {"$ref": "#/$defs/bindingInputs"}}, "unevaluatedProperties": false}]},
        {"allOf": [{"$ref": "#/$defs/nodeBase"}, {"type": "object", "properties": {"execution_unit": {"const": "TOOL-02"}, "capability_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["CAP-002", "CAP-003", "CAP-004", "CAP-005"]}}, "inputs": {"$ref": "#/$defs/identityInputs"}}, "unevaluatedProperties": false}]},
        {"allOf": [{"$ref": "#/$defs/nodeBase"}, {"type": "object", "properties": {"execution_unit": {"const": "TOOL-03"}}, "oneOf": [{"properties": {"capability_ids": {"const": ["CAP-006"]}, "inputs": {"$ref": "#/$defs/seriesInputsCap006"}}}, {"properties": {"capability_ids": {"const": ["CAP-007"]}, "inputs": {"$ref": "#/$defs/seriesInputsCap007"}}}, {"properties": {"capability_ids": {"const": ["CAP-008"]}, "inputs": {"$ref": "#/$defs/seriesInputsCap008"}}}, {"properties": {"capability_ids": {"const": ["CAP-009"]}, "inputs": {"$ref": "#/$defs/seriesInputsCap009"}}}], "unevaluatedProperties": false}]},
        {"allOf": [{"$ref": "#/$defs/nodeBase"}, {"type": "object", "properties": {"execution_unit": {"const": "TOOL-04"}}, "oneOf": [{"properties": {"capability_ids": {"const": ["CAP-010"]}, "inputs": {"$ref": "#/$defs/asnListInputs"}}}, {"properties": {"capability_ids": {"const": ["CAP-011"]}, "inputs": {"$ref": "#/$defs/asnDetailInputs"}}}], "unevaluatedProperties": false}]},
        {"allOf": [{"$ref": "#/$defs/nodeBase"}, {"type": "object", "properties": {"execution_unit": {"const": "TOOL-05"}, "capability_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["CAP-012", "CAP-013"]}}, "inputs": {"$ref": "#/$defs/pathInputs"}}, "unevaluatedProperties": false}]},
        {"allOf": [{"$ref": "#/$defs/nodeBase"}, {"type": "object", "properties": {"execution_unit": {"const": "TOOL-06"}, "capability_ids": {"const": ["CAP-014"]}, "inputs": {"$ref": "#/$defs/identityInputs"}}, "unevaluatedProperties": false}]},
        {"allOf": [{"$ref": "#/$defs/nodeBase"}, {"type": "object", "properties": {"execution_unit": {"const": "OP-01"}, "capability_ids": {"const": ["CAP-016"]}, "inputs": {"$ref": "#/$defs/extremaInputs"}}, "unevaluatedProperties": false}]},
        {"allOf": [{"$ref": "#/$defs/nodeBase"}, {"type": "object", "properties": {"execution_unit": {"const": "OP-02"}, "capability_ids": {"const": ["CAP-017"]}, "inputs": {"$ref": "#/$defs/compareInputs"}}, "unevaluatedProperties": false}]},
        {"allOf": [{"$ref": "#/$defs/nodeBase"}, {"type": "object", "properties": {"execution_unit": {"const": "OP-03"}, "capability_ids": {"const": ["CAP-018"]}, "inputs": {"$ref": "#/$defs/timelineInputs"}}, "unevaluatedProperties": false}]}
      ]
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goal_id", "answerability", "node_ids", "reason_codes"],
      "properties": {
        "goal_id": {"type": "string", "pattern": "^goal-[1-9][0-9]*$"},
        "answerability": {"enum": ["supported", "partial", "clarify", "unsupported", "invalid_data"]},
        "node_ids": {"type": "array", "items": {"type": "string", "pattern": "^node-[1-9][0-9]*$"}, "uniqueItems": true},
        "reason_codes": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}
      },
      "allOf": [
        {"if": {"properties": {"answerability": {"enum": ["supported", "partial"]}}}, "then": {"properties": {"node_ids": {"minItems": 1}}}},
        {"if": {"properties": {"answerability": {"enum": ["clarify", "unsupported", "invalid_data"]}}}, "then": {"properties": {"node_ids": {"maxItems": 0}}}}
      ]
    },
    "groundingPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan_revision", "identity", "decisions", "nodes", "authorization_scope", "validation"],
      "properties": {
        "plan_revision": {"const": "grounding-plan-v2"},
        "identity": {"$ref": "#/$defs/identity"},
        "decisions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/decision"}},
        "nodes": {"type": "array", "items": {"$ref": "#/$defs/node"}},
        "authorization_scope": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"const": "country_outage:read"}, "uniqueItems": true},
        "validation": {"type": "object", "additionalProperties": false, "required": ["status", "errors"], "properties": {"status": {"enum": ["pending", "passed", "rejected"]}, "errors": {"type": "array", "items": {"type": "string"}}}}
      }
    }
  }
}
