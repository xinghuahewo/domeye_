{
  "schema_version": "country_outage_p1_event_window_trend_synthetic_oracle_v4",
  "purpose": "与任何真实事件和专家主观分段隔离的产品语义 Oracle；时间和数值只用于通用算法回归。",
  "base_timestamp_utc": "2025-01-01T00:00:00Z",
  "default_interval_ms": 300000,
  "cases": [
    {
      "case_id": "ORACLE-STOCK-MONOTONIC-UP",
      "metric": "affected_asn_count",
      "values": [10, 12, 15, 18, 21],
      "expected": { "global_shape": "monotonic_increase", "net_change": 11, "maximum_decline": null, "maximum_rebound_change": 11, "largest_adjacent_step_down": null, "largest_adjacent_step_up_change": 3 }
    },
    {
      "case_id": "ORACLE-STOCK-MONOTONIC-DOWN",
      "metric": "affected_asn_count",
      "values": [21, 18, 15, 12, 10],
      "expected": { "global_shape": "monotonic_decrease", "net_change": -11, "maximum_decline_change": -11, "maximum_rebound": null, "largest_adjacent_step_down_change": -3, "largest_adjacent_step_up": null }
    },
    {
      "case_id": "ORACLE-STOCK-FLAT",
      "metric": "affected_asn_count",
      "values": [10, 10, 10, 10, 10],
      "expected": { "global_shape": "stable", "net_change": 0, "turning_point_count": 0, "largest_adjacent_step_down": null, "largest_adjacent_step_up": null }
    },
    {
      "case_id": "ORACLE-STOCK-PARTIAL-REBOUND",
      "metric": "affected_asn_count",
      "values": [100, 100, 80, 50, 50, 70, 70],
      "expected": { "global_shape": "decrease_then_partial_rebound", "baseline": 100, "tail_baseline_relation": "below" }
    },
    {
      "case_id": "ORACLE-STOCK-RETURN-BASELINE",
      "metric": "affected_asn_count",
      "values": [100, 100, 80, 50, 50, 100, 100],
      "expected": { "global_shape": "decrease_then_return_to_baseline", "baseline": 100, "tail_baseline_relation": "near" }
    },
    {
      "case_id": "ORACLE-STOCK-MULTI-PHASE",
      "metric": "affected_asn_count",
      "values": [100, 100, 70, 70, 90, 90, 50, 50, 75, 75, 55, 55],
      "expected": { "global_shape": "multi_phase", "minimum_turning_point_count": 3 }
    },
    {
      "case_id": "ORACLE-STOCK-ISOLATED-SPIKE",
      "metric": "affected_asn_count",
      "values": [100, 100, 180, 100, 100],
      "expected": { "global_shape": "stable", "turning_point_count": 0, "isolated_spike_count": 1, "largest_adjacent_step_up_change": 80, "largest_adjacent_step_down_change": -80, "analysis_rule": "原值登记尖峰与相邻最大步长，持续形态用居中三点中位数抑制该尖峰" }
    },
    {
      "case_id": "ORACLE-STOCK-PERSISTENT-LEVEL-SHIFT",
      "metric": "affected_asn_count",
      "values": [100, 100, 180, 180, 180],
      "expected": { "global_shape": "monotonic_increase", "isolated_spike_count": 0, "largest_adjacent_step_up_change": 80 }
    },
    {
      "case_id": "ORACLE-DISPLAY-COMPRESSION",
      "metric": "affected_asn_count",
      "values": [100, 100, 70, 95, 60, 90, 50, 85, 40, 80, 30, 75, 20, 70, 10, 65],
      "expected": { "minimum_audit_phase_count": 7, "maximum_display_phase_count": 6 }
    },
    {
      "case_id": "ORACLE-CURRENT-SUPPLEMENT",
      "metric": "new_visible_ipv4_prefix_count",
      "values": [0, 10, 10, 5, 5],
      "expected": { "series_semantics": "current_supplement", "global_shape": "rise_then_below_baseline", "maximum_decline_change": -5, "maximum_rebound_change": 10 }
    },
    {
      "case_id": "ORACLE-NULL-HARD-GAP",
      "metric": "affected_asn_count",
      "values": [100, 100, null, null, 50, 50],
      "expected": { "null_point_count": 2, "gap_count": 1, "maximum_decline": null, "interpolation": "forbidden" }
    },
    {
      "case_id": "ORACLE-TAIL-NULL",
      "metric": "affected_asn_count",
      "values": [100, 90, 80, null, null],
      "expected": { "tail_observation": "before_data_through", "trailing_null_point_count": 2 }
    },
    {
      "case_id": "ORACLE-CUMULATIVE",
      "metric": "new_cumulative_ipv4_prefix_count",
      "values": [0, 1, 1, 4, 7],
      "expected": { "global_shape": "cumulative_growth", "maximum_decline": null, "maximum_rebound": null, "net_change": 7, "largest_adjacent_step_down": null, "largest_adjacent_step_up_change": 3 }
    },
    {
      "case_id": "ORACLE-STRICT-DIRECTIONAL-MAXIMUM-STEPS",
      "metric": "affected_asn_count",
      "values": [10, 14, 13, 20, 15, 15],
      "expected": { "largest_adjacent_step_down_change": -5, "largest_adjacent_step_up_change": 7 }
    },
    {
      "case_id": "ORACLE-IRREGULAR-TIME",
      "metric": "affected_asn_count",
      "offsets_ms": [0, 60000, 180000, 600000],
      "values": [10, 20, 30, 40],
      "expected": { "irregular_interval": true, "observed_span_ms": 600000 }
    },
    {
      "case_id": "ORACLE-SHORT",
      "metric": "affected_asn_count",
      "values": [10, 20],
      "expected": { "quality_status": "insufficient", "global_shape": "insufficient_data" }
    }
  ],
  "compact_cases": [
    {
      "case_id": "ORACLE-COMPACT-VISIBILITY-PARTIAL-REBOUND",
      "metric": "fixed_visible_ipv4_address_count",
      "values": [1000, 1000, 700, 700, 900],
      "expected": { "semantic_role": "visibility_stock", "required_cards": ["first", "minimum", "last", "net_change"], "body_contains": ["窗口最低", "部分回升"] }
    },
    {
      "case_id": "ORACLE-COMPACT-INTERRUPTION-SPIKE",
      "metric": "affected_asn_count",
      "values": [10, 10, 40, 10, 10],
      "expected": { "semantic_role": "interruption_stock", "required_cards": ["maximum", "isolated_spike", "last", "net_change"], "body_contains": ["窗口峰值", "单槽尖峰"] }
    },
    {
      "case_id": "ORACLE-COMPACT-CUMULATIVE-PLATEAU",
      "metric": "new_cumulative_ipv4_prefix_count",
      "values": [0, 1, 1, 4, 7, 7],
      "expected": { "semantic_role": "cumulative_new", "required_cards": ["last", "net_change", "largest_adjacent_step_up"], "body_contains": ["累计", "最大单槽增加", "保持至截止"], "body_excludes": ["下降", "恢复"] }
    },
    {
      "case_id": "ORACLE-COMPACT-CURRENT-SUPPLEMENT",
      "metric": "new_visible_ipv4_prefix_count",
      "values": [0, 10, 10, 5, 5],
      "expected": { "semantic_role": "current_supplement", "required_cards": ["maximum", "last", "net_change"], "body_contains": ["当前可见补充量"], "body_excludes": ["累计值", "累计增加"] }
    },
    {
      "case_id": "ORACLE-COMPACT-TAIL-NULL",
      "metric": "affected_asn_count",
      "values": [100, 90, 80, null, null],
      "expected": { "semantic_role": "interruption_stock", "required_cards": ["last", "tail_null"], "required_limitations": ["tail-unobserved"], "body_contains": ["最后有效观测"] }
    }
  ],
  "compact_bundle_cases": [
    {
      "case_id": "ORACLE-COMPACT-BUNDLE-FIXED-IP",
      "bundle_profile_id": "fixed-ip-address-change-v1",
      "tracks": {
        "fixed_visible_ipv4_address_count": [1000, 1000, 700, 900],
        "fixed_visible_ipv6_slash48_count": [20, 20, 18, 19]
      },
      "expected": { "body_contains": ["IPv4 唯一地址", "IPv6 /48 等价量", "不合并"], "ipv4_unit": "unique_ipv4_address", "ipv6_unit": "ipv6_slash48_equivalent", "cross_unit_aggregation": "forbidden" }
    }
  ],
  "multi_track_cases": [
    {
      "case_id": "ORACLE-MULTI-OPPOSING-STEP",
      "tracks": {
        "interrupted_prefix_count": [10, 10, 30, 30],
        "fixed_visible_ipv4_address_count": [1000, 1000, 700, 700]
      },
      "expected": { "kind": "same_interval_change", "relation": "opposing_numeric_direction", "from_index": 1, "to_index": 2 }
    },
    {
      "case_id": "ORACLE-MULTI-SYNCHRONIZED-SPIKE",
      "tracks": {
        "affected_asn_count": [10, 10, 40, 10, 10],
        "interrupted_prefix_count": [100, 100, 400, 100, 100]
      },
      "expected": { "kind": "synchronized_isolated_spike", "from_index": 1, "to_index": 3 }
    },
    {
      "case_id": "ORACLE-MULTI-CUMULATIVE-CURRENT-DIVERGENCE",
      "tracks": {
        "new_cumulative_ipv6_prefix_count": [0, 1, 1, 1],
        "new_visible_ipv6_prefix_count": [0, 1, 0, 0]
      },
      "expected": { "kind": "cumulative_current_divergence", "from_index": 1, "to_index": 2 }
    }
  ]
}
