{
  "schema_version": "country_outage_p1_trend_profile_registry_v3",
  "registry_revision": 3,
  "presentation_rule": "display_label_zh 与 unit_label_zh 是 compact chat 的登记文案；正文不得回退为 metric id 或原始 unit code。",
  "registry_rule": "调用方必须提交完整登记 Profile；实现逐字段校验，用户或 LLM 不得临时填写阈值。",
  "parameter_semantics": {
    "baseline_observed_points": "从轨道起点按时间顺序取多少个非 null 观测，以其中位数作为基线。",
    "median_filter_radius": "每侧点数半径；仅在同一无缺口连续段且窗口完整时使用居中中位数。0 表示不平滑。",
    "change_threshold_absolute": "本单位下构成显著方向变化的最小绝对量。",
    "change_threshold_relative_to_baseline": "基线绝对值的比例阈值；最终阈值取它与绝对阈值中的较大者。",
    "change_threshold_relative_to_observed_range": "完整非空观测极差的比例阈值；最终阈值同时取绝对、基线相对和极差相对阈值中的较大者，用于压制相对全窗幅度很小的往返噪声。",
    "gap_interval_multiplier": "相邻时间差超过 nominal interval 的该倍数时切断连续段。",
    "tail_observed_points": "从最后一个连续观测段末尾取多少个分析点，以首末差和同一显著阈值判定 recent_direction。",
    "minimum_observed_points": "少于该数量时只给点事实，global_shape 为 insufficient_data。",
    "cumulative_decrease_tolerance": "累计轨道允许的数值回退量；当前登记全部为 0。",
    "isolated_spike_threshold_multiplier": "单槽中心相对两侧均值的偏离至少达到 change_threshold 的该倍数，才登记为尖峰。",
    "isolated_spike_return_tolerance_multiplier": "单槽尖峰两侧点的差值最多为 change_threshold 的该倍数；超过时视为持续变化而非孤立尖峰。",
    "display_max_phases_per_run": "每个无缺口连续段在聊天展示层最多保留的阶段数；审计阶段不受此上限影响。",
    "display_max_facts": "单轨聊天展示层按确定性显著性排序保留的事实数；完整机器结果和 lineage 不删减。"
  },
