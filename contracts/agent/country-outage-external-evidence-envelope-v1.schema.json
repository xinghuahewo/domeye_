{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domeye.invalid/contracts/agent/country-outage-external-evidence-envelope-v1.schema.json",
  "title": "国家中断外部证据 Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provider",
    "provider_version",
    "policy_version",
    "policy_sha256",
    "status",
    "evidence_status",
    "requested_at",
    "retrieved_at",
    "frozen_binding",
    "sources",
    "claims"
  ],
  "properties": {
    "schema_version": {
      "const": "country_outage_external_evidence_envelope_v1"
    },
    "provider": {
      "const": "managed-egress-v1"
    },
    "provider_version": {
      "type": "string",
      "minLength": 1
    },
    "policy_version": {
      "const": "country-outage-external-v1"
    },
    "policy_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "status": {
      "enum": [
        "completed",
        "partial",
        "failed"
      ]
    },
    "evidence_status": {
      "enum": [
        "supported",
        "mixed",
        "conflict",
        "insufficient"
      ]
    },
    "requested_at": {
      "$ref": "#/$defs/dateTime"
    },
    "retrieved_at": {
      "anyOf": [
        {
          "$ref": "#/$defs/dateTime"
        },
        {
          "type": "null"
        }
      ]
    },
    "frozen_binding": {
      "$ref": "#/$defs/frozenBinding"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/error"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "dateTime": {
      "type": "string",
      "format": "date-time"
    },
    "nullableString": {
      "type": [
        "string",
        "null"
      ]
    },
    "frozenBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "incident_id",
        "publication_id",
        "revision",
        "data_through",
        "fact_set_id",
        "cohort_id",
        "country_code",
        "collector_id",
        "window_start_utc",
        "window_end_utc"
      ],
      "properties": {
        "incident_id": {
          "type": "string",
          "minLength": 1
        },
        "publication_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "data_through": {
          "anyOf": [
            {
              "$ref": "#/$defs/dateTime"
            },
            {
              "type": "null"
            }
          ]
        },
        "fact_set_id": {
          "type": "string",
          "minLength": 1
        },
        "cohort_id": {
          "type": "string",
          "minLength": 1
        },
        "country_code": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "collector_id": {
          "const": "rrc25"
        },
        "window_start_utc": {
          "$ref": "#/$defs/dateTime"
        },
        "window_end_utc": {
          "$ref": "#/$defs/dateTime"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "fetched"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "final_url": {
                "type": "string",
                "format": "uri"
              },
              "retrieved_at": {
                "$ref": "#/$defs/dateTime"
              },
              "content_sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        }
      ],
      "required": [
        "source_id",
        "adapter_id",
        "status",
        "evidence_status",
        "source_url",
        "final_url",
        "title",
        "publisher",
        "published_at",
        "retrieved_at",
        "summary",
        "content_sha256"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "adapter_id": {
          "enum": [
            "hurricane-electric-v1",
            "cloudflare-radar-v1"
          ]
        },
        "status": {
          "enum": [
            "fetched",
            "blocked",
            "failed"
          ]
        },
        "evidence_status": {
          "enum": [
            "available",
            "insufficient",
            "read_failed"
          ]
        },
        "source_url": {
          "type": "string",
          "format": "uri"
        },
        "final_url": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "type": "null"
            }
          ]
        },
        "title": {
          "$ref": "#/$defs/nullableString"
        },
        "publisher": {
          "$ref": "#/$defs/nullableString"
        },
        "published_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/dateTime"
            },
            {
              "type": "null"
            }
          ]
        },
        "retrieved_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/dateTime"
            },
            {
              "type": "null"
            }
          ]
        },
        "summary": {
          "$ref": "#/$defs/nullableString"
        },
        "content_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "status_detail": {
          "$ref": "#/$defs/nullableString"
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "text",
        "status",
        "source_ids",
        "limitations"
      ],
      "properties": {
        "claim_id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "supported",
            "mixed",
            "conflict",
            "insufficient"
          ]
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "retryable": {
          "type": "boolean"
        },
        "next_action": {
          "type": "string"
        }
      }
    }
  }
}
