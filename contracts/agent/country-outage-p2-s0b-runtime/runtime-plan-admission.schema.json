{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domeye.local/contracts/country-outage-p2-s0b-runtime-plan-admission.schema.json",
  "title": "国家中断 Agent P2-S0B Runtime Registry 准入回执",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "registry_snapshot_id",
    "registry_revision",
    "candidate_id",
    "event_identity",
    "goal_resolutions",
    "admitted_nodes",
    "execution_started",
    "production_deployed"
  ],
  "properties": {
    "schema_version": {"const": "country_outage_p2_s0b_registry_admission_v1"},
    "status": {"const": "admitted"},
    "registry_snapshot_id": {"type": "string", "pattern": "^registry-snapshot-sha256:[a-f0-9]{64}$"},
    "registry_revision": {"type": "integer", "minimum": 1},
    "candidate_id": {"type": "string", "pattern": "^p2-s0b-[a-f0-9]{16}$"},
    "event_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_type", "incident_id", "publication_id", "revision", "collector_id"],
      "properties": {
        "event_type": {"const": "country_outage"},
        "incident_id": {"type": "string", "minLength": 1},
        "publication_id": {"type": "string", "minLength": 1},
        "revision": {"type": "integer", "minimum": 1},
        "collector_id": {"const": "rrc25"}
      }
    },
    "goal_resolutions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["goal_id", "normalized_kind", "disposition", "capability_ids", "execution_unit_ids", "call_policy"],
        "properties": {
          "goal_id": {"type": "string", "minLength": 1},
          "normalized_kind": {"type": "string", "minLength": 1},
          "disposition": {"enum": ["supported", "partial", "pending_clarification", "unsupported"]},
          "capability_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "execution_unit_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "call_policy": {"enum": ["required", "conditional", "forbidden"]}
        }
      }
    },
    "admitted_nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["node_id", "goal_id", "execution_unit_id", "execution_unit_version", "capability_ids"],
        "properties": {
          "node_id": {"type": "string", "minLength": 1},
          "goal_id": {"type": "string", "minLength": 1},
          "execution_unit_id": {"type": "string", "pattern": "^(TOOL|OP)-[0-9]{2}$"},
          "execution_unit_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
          "capability_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
        }
      }
    },
    "execution_started": {"const": false},
    "production_deployed": {"const": false}
  }
}
