{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domeye.local/contracts/info/static-info-manifest-v1.schema.json",
  "title": "Domeye static INFO 内容清单 v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "component",
    "source_release_label",
    "generated_at",
    "parser_version",
    "full_importer_version",
    "importer_config_sha256",
    "manifest_sha256",
    "content_id",
    "file_count",
    "files",
    "documentation_files"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "component": {"const": "static_info"},
    "source_release_label": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "parser_version": {"const": "info-parser-v5"},
    "full_importer_version": {"const": "info-full-importer-v2"},
    "importer_config_sha256": {"$ref": "#/$defs/sha256"},
    "manifest_sha256": {"$ref": "#/$defs/sha256"},
    "content_id": {
      "type": "string",
      "pattern": "^info_v1_[0-9a-f]{32}$"
    },
    "file_count": {"const": 24},
    "files": {
      "type": "array",
      "minItems": 24,
      "maxItems": 24,
      "items": {"$ref": "#/$defs/dataFile"}
    },
    "documentation_files": {
      "type": "array",
      "maxItems": 1,
      "items": {"$ref": "#/$defs/documentationFile"}
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nonnegativeInteger": {
      "type": "integer",
      "minimum": 0
    },
    "dataFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "dataset_kind",
        "file_format",
        "role",
        "parser",
        "encoding",
        "delimiter",
        "source_priority",
        "size_bytes",
        "sha256",
        "modified_time_ns",
        "inode",
        "physical_line_count",
        "header",
        "header_sha256",
        "logical_record_count",
        "count_method"
      ],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "dataset_kind": {"type": "string", "minLength": 1},
        "file_format": {
          "enum": ["csv", "json", "line_text", "xls", "xlsx"]
        },
        "role": {
          "enum": ["active", "loaded_not_consumed", "config_only", "legacy"]
        },
        "parser": {"type": "string", "minLength": 1},
        "encoding": {"type": ["string", "null"], "minLength": 1},
        "delimiter": {"type": ["string", "null"], "maxLength": 1},
        "source_priority": {"type": ["integer", "null"], "minimum": 0},
        "size_bytes": {"$ref": "#/$defs/nonnegativeInteger"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "modified_time_ns": {"$ref": "#/$defs/nonnegativeInteger"},
        "inode": {"$ref": "#/$defs/nonnegativeInteger"},
        "physical_line_count": {"$ref": "#/$defs/nonnegativeInteger"},
        "header": {
          "type": "array",
          "items": {"type": "string"}
        },
        "header_sha256": {"$ref": "#/$defs/sha256"},
        "logical_record_count": {"$ref": "#/$defs/nonnegativeInteger"},
        "count_method": {"type": "string", "minLength": 1}
      }
    },
    "documentationFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "size_bytes",
        "sha256",
        "modified_time_ns",
        "physical_line_count"
      ],
      "properties": {
        "name": {"const": "README.md"},
        "size_bytes": {"$ref": "#/$defs/nonnegativeInteger"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "modified_time_ns": {"$ref": "#/$defs/nonnegativeInteger"},
        "physical_line_count": {"$ref": "#/$defs/nonnegativeInteger"}
      }
    }
  }
}
