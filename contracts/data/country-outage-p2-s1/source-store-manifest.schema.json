{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domeye.example/contracts/data/country-outage-p2-s1/source-store-manifest.schema.json",
  "title": "RRC25 P2-S1 六人口 Source Store Manifest",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "store_id", "identity", "source_profiles_ref", "population_manifests", "content_sha256"],
  "properties": {
    "schema_version": {"const": "country_outage_p2_s1_source_store_manifest_v1"}, "store_id": {"type": "string", "pattern": "^country_outage_p2_s1_source_store_v1_[0-9a-f]{64}$"},
    "identity": {"type": "object", "additionalProperties": false, "required": ["incident_id", "publication_id", "publication_revision", "publication_digest", "collector_id", "cohort_id", "cohort_digest", "window_start_utc", "window_end_utc", "data_through_utc", "finality", "grid_seconds"], "properties": {"incident_id": {"type": "string", "minLength": 1}, "publication_id": {"type": "string", "minLength": 1}, "publication_revision": {"type": "integer", "minimum": 1}, "publication_digest": {"$ref": "common.schema.json#/$defs/sha256"}, "collector_id": {"const": "rrc25"}, "cohort_id": {"type": "string", "minLength": 1}, "cohort_digest": {"$ref": "common.schema.json#/$defs/sha256"}, "window_start_utc": {"$ref": "common.schema.json#/$defs/utc"}, "window_end_utc": {"$ref": "common.schema.json#/$defs/utc"}, "data_through_utc": {"$ref": "common.schema.json#/$defs/utc"}, "finality": {"type": "string", "enum": ["event_end_unknown", "event_end_known"]}, "grid_seconds": {"type": "integer", "minimum": 1}}},
    "source_profiles_ref": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"const": "source-profiles.json"}, "sha256": {"$ref": "common.schema.json#/$defs/sha256"}}},
    "population_manifests": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"type": "object", "additionalProperties": false, "required": ["population_id", "schema_ref", "schema_sha256", "readiness", "blocking_codes", "row_file", "index_file", "row_count", "member_keys_digest", "materialization_receipt_digest", "materialization_receipt_ref", "source_refs"], "properties": {"population_id": {"type": "string"}, "schema_ref": {"type": "string", "minLength": 1}, "schema_sha256": {"$ref": "common.schema.json#/$defs/sha256"}, "readiness": {"type": "string", "enum": ["ready", "blocked_source_semantics"]}, "blocking_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "row_file": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "size_bytes"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "common.schema.json#/$defs/sha256"}, "size_bytes": {"type": "integer", "minimum": 0}}}, "index_file": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "size_bytes"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "common.schema.json#/$defs/sha256"}, "size_bytes": {"type": "integer", "minimum": 0}}}, "row_count": {"type": "integer", "minimum": 0}, "member_keys_digest": {"$ref": "common.schema.json#/$defs/sha256"}, "materialization_receipt_digest": {"$ref": "common.schema.json#/$defs/sha256"}, "materialization_receipt_ref": {"type": "string", "minLength": 1}, "source_refs": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/sourceRef"}}}}},
    "content_sha256": {"$ref": "common.schema.json#/$defs/sha256"}
  }
}
