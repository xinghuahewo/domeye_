{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domeye.example/contracts/data/country-outage-p2-s1/new-prefix-state-row.schema.json",
  "title": "New-prefix 状态原子事实行",
  "description": "PROFILE-NEW-PREFIX-FIXED-FIRST-OBSERVED-DIRECTIONS-1.0.0 的稠密状态轨；first_observed 仅指 cohort 冻结后首次被 RRC25 观察。",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "publication_id", "new_prefix_state_id", "prefix", "afi", "first_observed_at_utc", "state_point_utc", "classification", "expected_peer_asn_direction_ids", "visible_direction_count", "invisible_direction_count", "unknown_direction_count", "projection_profile_id", "projection_profile_digest", "member_key", "row_digest", "source_record_refs"],
  "properties": {
    "schema_version": {"const": "country_outage_p2_s1_new_prefix_state_row_v1"}, "publication_id": {"type": "string", "minLength": 1}, "new_prefix_state_id": {"type": "string", "pattern": "^new_prefix_state_v1_[0-9a-f]{32}$"}, "prefix": {"type": "string", "minLength": 3}, "afi": {"$ref": "common.schema.json#/$defs/afi"}, "first_observed_at_utc": {"$ref": "common.schema.json#/$defs/utc"}, "state_point_utc": {"$ref": "common.schema.json#/$defs/utc"},
    "classification": {"type": "string", "enum": ["normal", "partial", "complete", "unknown"]}, "expected_peer_asn_direction_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "visible_direction_count": {"type": "integer", "minimum": 0}, "invisible_direction_count": {"type": "integer", "minimum": 0}, "unknown_direction_count": {"type": "integer", "minimum": 0},
    "projection_profile_id": {"const": "PROFILE-NEW-PREFIX-FIXED-FIRST-OBSERVED-DIRECTIONS-1.0.0"}, "projection_profile_digest": {"$ref": "common.schema.json#/$defs/sha256"}, "member_key": {"type": "string", "pattern": "^p2s1_member_v1_[0-9a-f]{64}$"}, "row_digest": {"$ref": "common.schema.json#/$defs/sha256"}, "source_record_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
