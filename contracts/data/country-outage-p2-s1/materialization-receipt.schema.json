{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domeye.example/contracts/data/country-outage-p2-s1/materialization-receipt.schema.json",
  "title": "P2-S1 单人口物化回执",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "status", "population_id", "publication_id", "source_refs", "schema_sha256", "row_file_sha256", "index_digest", "row_count", "member_keys_digest", "materializer_id", "materializer_version", "profile_bindings", "content_sha256"],
  "properties": {
    "schema_version": {"const": "country_outage_p2_s1_materialization_receipt_v1"}, "receipt_id": {"type": "string", "pattern": "^p2s1_materialization_receipt_v1_[0-9a-f]{64}$"}, "status": {"const": "materialized_ready"}, "population_id": {"type": "string", "minLength": 1}, "publication_id": {"type": "string", "minLength": 1}, "source_refs": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/sourceRef"}}, "schema_sha256": {"$ref": "common.schema.json#/$defs/sha256"}, "row_file_sha256": {"$ref": "common.schema.json#/$defs/sha256"}, "index_digest": {"$ref": "common.schema.json#/$defs/sha256"}, "row_count": {"type": "integer", "minimum": 0}, "member_keys_digest": {"$ref": "common.schema.json#/$defs/sha256"}, "materializer_id": {"const": "country_outage_p2_s1_source_view_builder"}, "materializer_version": {"const": "1.0.0"}, "profile_bindings": {"type": "object"}, "content_sha256": {"$ref": "common.schema.json#/$defs/sha256"}
  }
}
