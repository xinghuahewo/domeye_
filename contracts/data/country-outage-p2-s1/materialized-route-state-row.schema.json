{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domeye.example/contracts/data/country-outage-p2-s1/materialized-route-state-row.schema.json",
  "title": "精确时点 RouteState 原子事实行",
  "type": "object", "additionalProperties": false,
