  "properties": {
    "schema_version": {"const": "country_outage_p2_s1_materialized_route_state_row_v1"}, "publication_id": {"type": "string", "minLength": 1}, "state_point_utc": {"$ref": "common.schema.json#/$defs/utc"}, "prefix": {"type": "string", "minLength": 3}, "afi": {"$ref": "common.schema.json#/$defs/afi"}, "peer_asn_direction_id": {"type": "string", "minLength": 1}, "route_observation_key": {"type": "string", "minLength": 1}, "vp_id": {"type": "string", "minLength": 1}, "peer_id": {"type": "string", "minLength": 1},
    "visibility": {"type": "string", "enum": ["visible", "invisible", "unknown", "missing"]}, "origin_status": {"type": "string", "enum": ["known", "unknown", "ambiguous", "not_applicable"]}, "origin_asns": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/asn"}}, "path_status": {"type": "string", "enum": ["known", "unknown", "ambiguous", "not_applicable"]}, "common_path_status": {"type": "string", "enum": ["ordered", "unordered", "ambiguous", "invalid", "unknown", "not_applicable"]}, "path_id": {"type": ["string", "null"]}, "path_digest": {"anyOf": [{"$ref": "common.schema.json#/$defs/sha256"}, {"type": "null"}]}, "path_canonicalization_profile_id": {"type": ["string", "null"]}, "path_canonicalization_profile_digest": {"anyOf": [{"$ref": "common.schema.json#/$defs/sha256"}, {"type": "null"}]}, "path_segments": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/pathSegment"}},
    "last_event_id": {"type": "string", "minLength": 1}, "last_update_utc": {"$ref": "common.schema.json#/$defs/utc"}, "checkpoint_id": {"type": "string", "minLength": 1}, "projection_receipt_digest": {"$ref": "common.schema.json#/$defs/sha256"}, "quality_flags": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "member_key": {"type": "string", "pattern": "^p2s1_member_v1_[0-9a-f]{64}$"}, "row_digest": {"$ref": "common.schema.json#/$defs/sha256"}, "source_record_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
