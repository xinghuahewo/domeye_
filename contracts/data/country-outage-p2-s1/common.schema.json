{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domeye.example/contracts/data/country-outage-p2-s1/common.schema.json",
  "title": "RRC25 P2-S1 Source View 公共类型",
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "afi": {"type": "string", "enum": ["ipv4", "ipv6"]},
    "asn": {"type": "integer", "minimum": 0, "maximum": 4294967295},
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_kind", "dataset_id", "manifest_sha256", "content_sha256", "publication_id", "authority"],
      "properties": {
        "source_kind": {"type": "string", "minLength": 1},
        "dataset_id": {"type": "string", "minLength": 1},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "publication_id": {"type": "string", "minLength": 1},
        "authority": {"type": "string", "enum": ["rrc25_authoritative_artifact", "rrc25_authoritative_offline_projection"]}
      }
    },
    "pathSegment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["segment_type", "asns"],
      "properties": {
        "segment_type": {"type": "string", "enum": ["as_sequence", "as_set", "confederation_sequence", "confederation_set"]},
        "asns": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/asn"}}
      }
    },
    "rowAudit": {
      "type": "object",
      "required": ["member_key", "row_digest", "source_record_refs"],
      "properties": {
        "member_key": {"type": "string", "pattern": "^p2s1_member_v1_[0-9a-f]{64}$"},
        "row_digest": {"$ref": "#/$defs/sha256"},
        "source_record_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
