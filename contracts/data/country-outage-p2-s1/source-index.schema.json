{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domeye.example/contracts/data/country-outage-p2-s1/source-index.schema.json",
  "title": "P2-S1 单人口物化索引",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "population_id", "publication_id", "member_key_fields", "members", "member_keys_digest", "secondary_indexes", "content_sha256"],
  "properties": {
    "schema_version": {"const": "country_outage_p2_s1_source_index_v1"}, "population_id": {"type": "string", "minLength": 1}, "publication_id": {"type": "string", "minLength": 1}, "member_key_fields": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "members": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["member_key", "row_ordinal", "row_digest"], "properties": {"member_key": {"type": "string", "pattern": "^p2s1_member_v1_[0-9a-f]{64}$"}, "row_ordinal": {"type": "integer", "minimum": 0}, "row_digest": {"$ref": "common.schema.json#/$defs/sha256"}}}},
    "member_keys_digest": {"$ref": "common.schema.json#/$defs/sha256"}, "secondary_indexes": {"type": "object"}, "content_sha256": {"$ref": "common.schema.json#/$defs/sha256"}
  }
}
