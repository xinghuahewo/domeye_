{
  "$id": "https://domeye.example/contracts/research/research-profile.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "const": "https://domeye.example/contracts/research/research-profile.schema.json"
    },
    "algorithms": {
      "additionalProperties": false,
      "properties": {
        "episode": {
          "additionalProperties": false,
          "properties": {
            "combine_rule": {"const": "any"},
            "confirm_consecutive_slots": {"minimum": 1, "type": "integer"},
            "damaged_as_ratio_above": {"maximum": 1, "minimum": 0, "type": "number"},
            "detected_assignment": {"const": "confirmation_slot"},
            "ipv4_visible_ratio_below": {"maximum": 1, "minimum": 0, "type": "number"},
            "onset_assignment": {"const": "first_anomalous_slot"},
            "version": {"minLength": 1, "type": "string"}
          },
          "required": [
            "version",
            "combine_rule",
            "ipv4_visible_ratio_below",
            "damaged_as_ratio_above",
            "confirm_consecutive_slots",
            "onset_assignment",
            "detected_assignment"
          ],
          "type": "object"
        },
        "recovery": {
          "additionalProperties": false,
          "properties": {
            "duration_states": {
              "prefixItems": [
                {"const": "exact"},
                {"const": "lower_bound"},
                {"const": "interval"},
                {"const": "unknown"}
              ],
              "items": false,
              "maxItems": 4,
              "minItems": 4,
              "type": "array"
            },
            "full_confirm_consecutive_slots": {"minimum": 1, "type": "integer"},
            "full_rule": {"const": "within_versioned_baseline_normal_band"},
            "partial_confirm_consecutive_slots": {"minimum": 1, "type": "integer"},
            "partial_visible_ratio_at_least": {"maximum": 1, "minimum": 0, "type": "number"},
            "recovery_states": {
              "prefixItems": [
                {"const": "ongoing"},
                {"const": "recovering"},
                {"const": "partially_recovered"},
                {"const": "fully_recovered"}
              ],
              "items": false,
              "maxItems": 4,
              "minItems": 4,
              "type": "array"
            },
            "version": {"minLength": 1, "type": "string"}
          },
          "required": [
            "version",
            "partial_visible_ratio_at_least",
            "partial_confirm_consecutive_slots",
            "full_rule",
            "full_confirm_consecutive_slots",
            "duration_states",
            "recovery_states"
          ],
          "type": "object"
        },
        "wave": {
          "additionalProperties": false,
          "properties": {
            "baseline_ratio_floor": {"maximum": 1, "minimum": 0, "type": "number"},
            "inter_wave_relation": {"const": "unknown_not_causal"},
            "mad_multiplier": {"minimum": 0, "type": "number"},
            "new_episode_requires_full_recovery": {"const": true},
            "significance_method": {"const": "max_baseline_ratio_or_scaled_mad"},
            "version": {"minLength": 1, "type": "string"}
          },
          "required": [
            "version",
            "significance_method",
            "baseline_ratio_floor",
            "mad_multiplier",
            "new_episode_requires_full_recovery",
            "inter_wave_relation"
          ],
          "type": "object"
        }
      },
      "required": ["episode", "wave", "recovery"],
      "type": "object"
    },
    "baseline": {
      "additionalProperties": false,
      "properties": {
        "membership": {
          "additionalProperties": false,
          "properties": {
            "dynamic_ir_origins": {"const": "include_during_window"},
            "mapping_view": {"const": "compatibility"},
            "source": {"const": "state_seed_rib"}
          },
          "required": ["source", "mapping_view", "dynamic_ir_origins"],
          "type": "object"
        },
        "normal_band": {
          "additionalProperties": false,
          "properties": {
            "absolute_floor_ratio": {"maximum": 1, "minimum": 0, "type": "number"},
            "mad_multiplier": {"minimum": 0, "type": "number"},
            "method": {"const": "median_plus_minus_max_scaled_mad_and_absolute_floor"},
            "version": {"minLength": 1, "type": "string"}
          },
          "required": ["method", "mad_multiplier", "absolute_floor_ratio", "version"],
          "type": "object"
        },
        "numeric": {
          "additionalProperties": false,
          "properties": {
            "candidate_start": {"const": "analysis_window_start"},
            "dispersion": {"const": "median_absolute_deviation"},
            "extension_direction": {"const": "forward"},
            "extension_step_seconds": {"minimum": 1, "type": "integer"},
            "initial_duration_seconds": {"minimum": 1, "type": "integer"},
            "max_duration_seconds": {"minimum": 1, "type": "integer"},
            "max_relative_mad": {"maximum": 1, "minimum": 0, "type": "number"},
            "metric": {"const": "ipv4_visible_unique_address_count"},
            "record_actual_window": {"const": true},
            "statistic": {"const": "median"},
            "stop_before_confirmed_onset": {"const": true},
            "unstable_exhausted_state": {"const": "incomplete"}
          },
          "required": [
            "metric",
            "candidate_start",
            "initial_duration_seconds",
            "statistic",
            "dispersion",
            "max_relative_mad",
            "extension_direction",
            "extension_step_seconds",
            "max_duration_seconds",
            "stop_before_confirmed_onset",
            "unstable_exhausted_state",
            "record_actual_window"
          ],
          "type": "object"
        }
      },
      "required": ["membership", "numeric", "normal_band"],
      "type": "object"
    },
    "collector_id": {"pattern": "^[a-z0-9][a-z0-9._-]{0,63}$", "type": "string"},
    "country_code": {"pattern": "^[A-Z]{2}$", "type": "string"},
    "country_mapping": {
      "additionalProperties": false,
      "properties": {
        "compatibility_view": {"const": "frozen_legacy_static_mapping"},
        "conflict_policy": {"const": "preserve_as_country_mapping_conflict"},
        "revised_view": {"const": "separate_non_overwriting_projection"},
        "source_binding": {"const": "resolver_manifest_path_and_sha256_required"},
        "unknown_policy": {"const": "preserve_as_country_mapping_unknown"}
      },
      "required": [
        "compatibility_view",
        "revised_view",
        "unknown_policy",
        "conflict_policy",
        "source_binding"
      ],
      "type": "object"
    },
    "input_selection": {
      "additionalProperties": false,
      "properties": {
        "analysis_ribs": {"$ref": "#/$defs/analysisRibRange"},
        "analysis_updates": {"$ref": "#/$defs/analysisUpdateRange"},
        "baseline_reference_rib": {
          "additionalProperties": false,
          "properties": {
            "complete_required": {"const": true},
            "expected_count": {"const": 1},
            "selection_policy": {"const": "nearest_complete_strictly_before_start"},
            "strictly_before_window_start": {"const": true}
          },
          "required": [
            "selection_policy",
            "strictly_before_window_start",
            "complete_required",
            "expected_count"
          ],
          "type": "object"
        },
        "catch_up_updates": {
          "additionalProperties": false,
          "properties": {
            "condition": {"const": "required_when_state_seed_precedes_window_start"},
            "end_boundary": {"const": "window_start_exclusive"},
            "start_boundary": {"const": "state_seed_time_inclusive"}
          },
          "required": ["condition", "start_boundary", "end_boundary"],
          "type": "object"
        },
        "filename_timestamp_timezone": {"const": "UTC"},
        "state_seed_rib": {
          "additionalProperties": false,
          "properties": {
            "allow_at_window_start": {"const": true},
            "complete_required": {"const": true},
            "selection_policy": {"const": "complete_at_start_or_nearest_complete_before"}
          },
          "required": ["selection_policy", "allow_at_window_start", "complete_required"],
          "type": "object"
        }
      },
      "required": [
        "filename_timestamp_timezone",
        "state_seed_rib",
        "baseline_reference_rib",
        "catch_up_updates",
        "analysis_updates",
        "analysis_ribs"
      ],
      "type": "object"
    },
    "measurement": {
      "additionalProperties": false,
      "properties": {
        "address_families": {
          "prefixItems": [{"const": "ipv4"}, {"const": "ipv6"}],
          "items": false,
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "as_visibility_classification": {"const": "per_afi_then_dual_stack"},
        "country_prefix_aggregation": {"const": "deduplicated_address_union_per_afi"},
        "ipv4_metrics": {
          "prefixItems": [
            {"const": "visible_unique_address_count"},
            {"const": "slash24_equivalent_count"}
          ],
          "items": false,
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "ipv6_metrics": {
          "prefixItems": [{"const": "slash48_equivalent_count"}],
          "items": false,
          "maxItems": 1,
          "minItems": 1,
          "type": "array"
        },
        "missing_value_policy": {"const": "preserve_value_state_never_coerce_to_zero"},
        "moas_policy": {"const": "preserve_all_origins_do_not_sum_as_totals_as_country_total"},
        "views": {
          "prefixItems": [{"const": "compatibility"}, {"const": "revised"}],
          "items": false,
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        }
      },
      "required": [
        "address_families",
        "views",
        "country_prefix_aggregation",
        "ipv4_metrics",
        "ipv6_metrics",
        "as_visibility_classification",
        "moas_policy",
        "missing_value_policy"
      ],
      "type": "object"
    },
    "output_policy": {
      "additionalProperties": false,
      "properties": {
        "atomic_publish": {"const": true},
        "frontend_changes": {"const": "forbidden"},
        "immutable_outputs": {"const": true},
        "optional_projection": {"const": "parquet"},
        "overwrite_existing": {"const": false},
        "production_deployment": {"const": "forbidden"},
        "required_format": {"const": "canonical_jsonl_gzip"}
      },
      "required": [
        "required_format",
        "optional_projection",
        "immutable_outputs",
        "atomic_publish",
        "overwrite_existing",
        "frontend_changes",
        "production_deployment"
      ],
      "type": "object"
    },
    "profile_kind": {"const": "bounded_country_outage_research"},
    "resource_limits": {
      "additionalProperties": false,
      "properties": {
        "database_writes": {"const": "forbidden"},
        "max_new_raw_read_bytes": {"minimum": 1, "type": "integer"},
        "max_temporary_bytes": {"minimum": 1, "type": "integer"},
        "max_worker_runtime_seconds": {"minimum": 1, "type": "integer"},
        "output_storage": {"const": "filesystem_only"},
        "worker_soft_stop_seconds": {"minimum": 1, "type": "integer"}
      },
      "required": [
        "max_new_raw_read_bytes",
        "max_temporary_bytes",
        "max_worker_runtime_seconds",
        "worker_soft_stop_seconds",
        "database_writes",
        "output_storage"
      ],
      "type": "object"
    },
    "schema_version": {"const": "research_profile_v1"},
    "study_id": {"pattern": "^[a-z0-9][a-z0-9._-]{2,127}$", "type": "string"},
    "time_basis": {"const": "UTC"},
    "window": {
      "additionalProperties": false,
      "properties": {
        "end_boundary_role": {"const": "state_boundary_only_excluded_from_updates"},
        "end_exclusive_utc": {"$ref": "#/$defs/utcSecond"},
        "granularity_seconds": {"minimum": 1, "type": "integer"},
        "interval_semantics": {"const": "half_open"},
        "observation_end_utc": {"$ref": "#/$defs/utcSecond"},
        "start_utc": {"$ref": "#/$defs/utcSecond"}
      },
      "required": [
        "start_utc",
        "end_exclusive_utc",
        "observation_end_utc",
        "granularity_seconds",
        "interval_semantics",
        "end_boundary_role"
      ],
      "type": "object"
    }
  },
  "required": [
    "$schema",
    "schema_version",
    "study_id",
    "profile_kind",
    "collector_id",
    "country_code",
    "time_basis",
    "window",
    "input_selection",
    "country_mapping",
    "baseline",
    "measurement",
    "algorithms",
    "resource_limits",
    "output_policy"
  ],
  "title": "RRC25 国家中断研究 Profile",
  "type": "object",
  "$defs": {
    "analysisRibRange": {
      "additionalProperties": false,
      "properties": {
        "end_boundary": {"const": "window_end_exclusive"},
        "expected_slot_count": {"minimum": 1, "type": "integer"},
        "slot_interval_seconds": {"minimum": 1, "type": "integer"},
        "start_boundary": {"const": "window_start_inclusive"}
      },
      "required": ["start_boundary", "end_boundary", "slot_interval_seconds", "expected_slot_count"],
      "type": "object"
    },
    "analysisUpdateRange": {
      "additionalProperties": false,
      "properties": {
        "end_boundary": {"const": "window_end_exclusive"},
        "expected_slot_count": {"minimum": 1, "type": "integer"},
        "slot_interval_seconds": {"minimum": 1, "type": "integer"},
        "start_boundary": {"const": "window_start_inclusive"}
      },
      "required": ["start_boundary", "end_boundary", "slot_interval_seconds", "expected_slot_count"],
      "type": "object"
    },
    "utcSecond": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "type": "string"
    }
  }
}
