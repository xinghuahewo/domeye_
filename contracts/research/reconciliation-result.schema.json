{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domeye.example/contracts/research/reconciliation-result.schema.json",
  "title": "伊朗国家中断主张级对账结果合同",
  "description": "逐项对账报告和旧数据库主张，强制区分观测、修订、不可验证与假设；RRC25 单源不得越界生成因果或意图结论。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "reconciliation_id", "run_id", "incident_ref", "report_source", "evidence_registry", "claims", "summary"],
  "properties": {
    "schema_version": {"const": "reconciliation-result/v1"},
    "reconciliation_id": {"type": "string", "pattern": "^reconciliation_v1_[0-9a-f]{24}$"},
    "run_id": {"type": "string", "pattern": "^research_run_v1_[0-9a-f]{24}$"},
    "incident_ref": {"type": "string", "minLength": 1},
    "report_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "sha256", "preserved_unmodified"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "preserved_unmodified": {"const": true}
      }
    },
    "evidence_registry": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/evidence"}
    },
    "claims": {
      "type": "array",
      "minItems": 11,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/claim"},
      "allOf": [
        {"contains": {"type": "object", "properties": {"claim_type": {"const": "report_event_time"}}, "required": ["claim_type"]}, "minContains": 1},
        {"contains": {"type": "object", "properties": {"claim_type": {"const": "ipv4_decline"}}, "required": ["claim_type"]}, "minContains": 1},
        {"contains": {"type": "object", "properties": {"claim_type": {"const": "recovery_state"}}, "required": ["claim_type"]}, "minContains": 1},
        {"contains": {"type": "object", "properties": {"claim_type": {"const": "report_affected_asn_ratio"}}, "required": ["claim_type"]}, "minContains": 1},
        {"contains": {"type": "object", "properties": {"claim_type": {"const": "report_visibility_class_counts"}}, "required": ["claim_type"]}, "minContains": 1},
        {"contains": {"type": "object", "properties": {"claim_type": {"const": "database_affected_asn_ratio"}}, "required": ["claim_type"]}, "minContains": 1},
        {"contains": {"type": "object", "properties": {"claim_type": {"const": "active_withdrawal_intent"}}, "required": ["claim_type"]}, "minContains": 1},
        {"contains": {"type": "object", "properties": {"claim_type": {"const": "physical_cut"}}, "required": ["claim_type"]}, "minContains": 1},
        {"contains": {"type": "object", "properties": {"claim_type": {"const": "bgp_session_closed"}}, "required": ["claim_type"]}, "minContains": 1},
        {"contains": {"type": "object", "properties": {"claim_type": {"const": "traffic_impact"}}, "required": ["claim_type"]}, "minContains": 1},
        {"contains": {"type": "object", "properties": {"claim_type": {"const": "government_intent"}}, "required": ["claim_type"]}, "minContains": 1}
      ]
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confirmed", "revised", "unverifiable", "hypothesis_only"],
      "properties": {
        "confirmed": {"type": "integer", "minimum": 0},
        "revised": {"type": "integer", "minimum": 0},
        "unverifiable": {"type": "integer", "minimum": 0},
        "hypothesis_only": {"type": "integer", "minimum": 0}
      }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "kind", "ref", "sha256"],
      "properties": {
        "evidence_id": {"type": "string", "pattern": "^evidence_v1_[0-9a-f]{24}$"},
        "kind": {"enum": ["sample", "episode", "wave", "episode_as", "route_event", "raw_record", "source_fact", "report_page", "limitation"]},
        "ref": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "claimValue": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "value_state", "unit", "snapshot_id", "missing_reason"],
          "properties": {
            "value": {"type": ["number", "string", "boolean"]},
            "value_state": {"enum": ["reported", "recomputed"]},
            "unit": {"type": ["string", "null"]},
            "snapshot_id": {"type": ["string", "null"]},
            "missing_reason": {"type": "null"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "value_state", "unit", "snapshot_id", "missing_reason"],
          "properties": {
            "value": {"type": "null"},
            "value_state": {"enum": ["unknown", "not_applicable"]},
            "unit": {"type": "null"},
            "snapshot_id": {"type": "null"},
            "missing_reason": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "claim_type", "source_claim_zh", "original_value", "recomputed_value", "rating", "evidence_scope", "causal_level", "evidence_refs", "counterevidence_refs", "limitations_zh", "rationale_zh"],
      "properties": {
        "claim_id": {"type": "string", "pattern": "^claim_v1_[0-9a-f]{24}$"},
        "claim_type": {"enum": ["report_event_time", "ipv4_decline", "recovery_state", "report_affected_asn_ratio", "report_visibility_class_counts", "database_affected_asn_ratio", "active_withdrawal_intent", "physical_cut", "bgp_session_closed", "traffic_impact", "government_intent"]},
        "source_claim_zh": {"type": "string", "minLength": 1},
        "original_value": {"$ref": "#/$defs/claimValue"},
        "recomputed_value": {"$ref": "#/$defs/claimValue"},
        "rating": {"enum": ["confirmed", "revised", "unverifiable", "hypothesis_only"]},
        "evidence_scope": {"enum": ["rrc25_only", "rrc25_with_external_corroboration"]},
        "causal_level": {"enum": ["observation", "association", "mechanism_hypothesis", "causal_hypothesis", "intent_hypothesis"]},
        "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^evidence_v1_[0-9a-f]{24}$"}},
        "counterevidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^evidence_v1_[0-9a-f]{24}$"}},
        "limitations_zh": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "rationale_zh": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"rating": {"enum": ["confirmed", "revised"]}}, "required": ["rating"]},
          "then": {
            "properties": {
              "recomputed_value": {
                "type": "object",
                "properties": {"value_state": {"const": "recomputed"}},
                "required": ["value_state"]
              },
              "evidence_refs": {"type": "array", "minItems": 1}
            }
          }
        },
        {
          "if": {
            "properties": {
              "claim_type": {"enum": ["active_withdrawal_intent", "physical_cut", "bgp_session_closed", "traffic_impact", "government_intent"]},
              "evidence_scope": {"const": "rrc25_only"}
            },
            "required": ["claim_type", "evidence_scope"]
          },
          "then": {
            "properties": {
              "rating": {"enum": ["unverifiable", "hypothesis_only"]},
              "causal_level": {"enum": ["mechanism_hypothesis", "causal_hypothesis", "intent_hypothesis"]}
            }
          }
        }
      ]
    }
  }
}
