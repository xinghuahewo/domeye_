{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domeye.example/contracts/research/research-evidence-package.schema.json",
  "title": "RRC25 国家中断研究证据包封装合同",
  "description": "统一 available 与 unresolved unavailable 状态，并以内容寻址 package_id 绑定 Evidence Bundle v2、研究 sidecar、Incident 和 Episode 集合。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_id",
    "evidence_package_state",
    "run_id",
    "incident_ids",
    "episode_ids",
    "bundles",
    "sidecar",
    "limitations_zh"
  ],
  "properties": {
    "schema_version": {"const": "research-evidence-package/v1"},
    "package_id": {"type": "string", "pattern": "^research_package_v1_[0-9a-f]{24}$"},
    "evidence_package_state": {"enum": ["available_no_episode", "available_with_episode", "unavailable_source_fact_unresolved"]},
    "run_id": {"type": "string", "pattern": "^research_run_v1_[0-9a-f]{24}$"},
    "incident_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^inc_v1_[0-9a-f]{24}$"}
    },
    "episode_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^episode_v1_[0-9a-f]{24}$"}
    },
    "incident_locators": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/incidentLocator"}
    },
    "bundles": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "https://domeye.example/contracts/data/evidence-bundle-v2.schema.json"}
    },
    "sidecar": {
      "oneOf": [
        {"$ref": "https://domeye.example/contracts/research/research-evidence-sidecar.schema.json"},
        {"type": "null"}
      ]
    },
    "limitations_zh": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "pattern": "[\\u3400-\\u4dbf\\u4e00-\\u9fff]"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"evidence_package_state": {"const": "available_no_episode"}}, "required": ["evidence_package_state"]},
      "then": {
        "properties": {
          "incident_locators": false,
          "incident_ids": {"type": "array", "minItems": 1},
          "episode_ids": {"type": "array", "maxItems": 0},
          "bundles": {"type": "array", "minItems": 1},
          "sidecar": {"$ref": "https://domeye.example/contracts/research/research-evidence-sidecar.schema.json"}
        }
      }
    },
    {
      "if": {"properties": {"evidence_package_state": {"const": "available_with_episode"}}, "required": ["evidence_package_state"]},
      "then": {
        "properties": {
          "incident_locators": false,
          "episode_ids": {"type": "array", "minItems": 1, "maxItems": 1},
          "sidecar": {"$ref": "https://domeye.example/contracts/research/research-evidence-sidecar.schema.json"}
        }
      }
    },
    {
      "if": {"properties": {"evidence_package_state": {"const": "unavailable_source_fact_unresolved"}}, "required": ["evidence_package_state"]},
      "then": {
        "required": ["incident_locators"],
        "properties": {
          "incident_ids": {"type": "array", "minItems": 1, "maxItems": 1},
          "incident_locators": {"type": "array", "minItems": 1, "maxItems": 1},
          "bundles": {"type": "array", "maxItems": 0},
          "sidecar": {"type": "null"}
        }
      }
    }
  ],
  "$defs": {
    "incidentLocator": {
      "type": "object",
      "required": ["incident_id", "detail_reference", "fact_link_status", "classification", "causal_conclusion"],
      "properties": {
        "incident_id": {"type": "string", "pattern": "^inc_v1_[0-9a-f]{24}$"},
        "detail_reference": {"type": "string", "minLength": 1},
        "fact_link_status": {"const": "unresolved"},
        "classification": {"const": "observation_only"},
        "causal_conclusion": {"type": "null"}
      }
    }
  }
}
