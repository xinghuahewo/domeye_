{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dataset_identity",
    "method",
    "track_analyses",
    "cross_track_patterns",
    "overall_description_zh",
    "boundary_statement_zh"
  ],
  "properties": {
    "dataset_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["incident_id", "publication_id", "revision", "collector_id", "window_start_utc", "window_end_utc", "data_through", "series_sha256"],
      "properties": {
        "incident_id": {"type": "string"},
        "publication_id": {"type": "string"},
        "revision": {"type": "integer"},
        "collector_id": {"type": "string"},
        "window_start_utc": {"type": "string"},
        "window_end_utc": {"type": "string"},
        "data_through": {"type": "string"},
        "series_sha256": {"type": "string"}
      }
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inspection_method", "null_policy", "phase_method", "subjective_judgments"],
      "properties": {
        "inspection_method": {"type": "string"},
        "null_policy": {"type": "string"},
        "phase_method": {"type": "string"},
        "subjective_judgments": {"type": "array", "items": {"type": "string"}}
      }
    },
    "track_analyses": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "metric_id", "label", "unit", "semantic_type", "point_count", "observed_count", "null_count",
          "first_observed", "last_observed", "minimum", "maximum", "largest_step_down", "largest_step_up",
          "turning_points", "phases", "fact_cards", "description_zh", "limitations_zh"
        ],
        "properties": {
          "metric_id": {"type": "string"},
          "label": {"type": "string"},
          "unit": {"type": "string"},
          "semantic_type": {"type": "string", "enum": ["stock", "cumulative", "current_supplement", "other"]},
          "point_count": {"type": "integer"},
          "observed_count": {"type": "integer"},
          "null_count": {"type": "integer"},
          "first_observed": {"$ref": "#/$defs/timedValue"},
          "last_observed": {"$ref": "#/$defs/timedValue"},
          "minimum": {"$ref": "#/$defs/timedValue"},
          "maximum": {"$ref": "#/$defs/timedValue"},
          "largest_step_down": {"$ref": "#/$defs/stepChange"},
          "largest_step_up": {"$ref": "#/$defs/stepChange"},
          "turning_points": {
            "type": "array",
            "maxItems": 12,
            "items": {"$ref": "#/$defs/turningPoint"}
          },
          "phases": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": {"$ref": "#/$defs/phase"}
          },
          "fact_cards": {
            "type": "array",
            "minItems": 3,
            "maxItems": 12,
            "items": {"$ref": "#/$defs/factCard"}
          },
          "description_zh": {"type": "string"},
          "limitations_zh": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "cross_track_patterns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pattern_id", "metric_ids", "claim_zh", "evidence_points", "confidence"],
        "properties": {
          "pattern_id": {"type": "string"},
          "metric_ids": {"type": "array", "minItems": 2, "items": {"type": "string"}},
          "claim_zh": {"type": "string"},
          "evidence_points": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidencePoint"}},
          "confidence": {"type": "string", "enum": ["high", "medium", "low"]}
        }
      }
    },
    "overall_description_zh": {"type": "string"},
    "boundary_statement_zh": {"type": "string"}
  },
  "$defs": {
    "timedValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timestamp", "index", "value"],
      "properties": {
        "timestamp": {"type": "string"},
        "index": {"type": "integer"},
        "value": {"type": "number"}
      }
    },
    "stepChange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from_timestamp", "to_timestamp", "from_index", "to_index", "from_value", "to_value", "delta"],
      "properties": {
        "from_timestamp": {"type": "string"},
        "to_timestamp": {"type": "string"},
        "from_index": {"type": "integer"},
        "to_index": {"type": "integer"},
        "from_value": {"type": "number"},
        "to_value": {"type": "number"},
        "delta": {"type": "number"}
      }
    },
    "turningPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timestamp", "index", "value", "kind", "evidence_reason_zh"],
      "properties": {
        "timestamp": {"type": "string"},
        "index": {"type": "integer"},
        "value": {"type": "number"},
        "kind": {"type": "string", "enum": ["peak", "trough", "level_shift", "slope_change", "plateau_start", "plateau_end"]},
        "evidence_reason_zh": {"type": "string"}
      }
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase_id", "start_timestamp", "end_timestamp", "start_index", "end_index", "direction", "shape", "start_value", "end_value", "minimum_value", "maximum_value", "description_zh"],
      "properties": {
        "phase_id": {"type": "string"},
        "start_timestamp": {"type": "string"},
        "end_timestamp": {"type": "string"},
        "start_index": {"type": "integer"},
        "end_index": {"type": "integer"},
        "direction": {"type": "string", "enum": ["up", "down", "flat", "mixed"]},
        "shape": {"type": "string", "enum": ["stable", "gradual", "abrupt", "volatile", "stepwise", "mixed"]},
        "start_value": {"type": "number"},
        "end_value": {"type": "number"},
        "minimum_value": {"type": "number"},
        "maximum_value": {"type": "number"},
        "description_zh": {"type": "string"}
      }
    },
    "factCard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fact_type", "claim_zh", "value", "timestamp", "evidence_index", "verifiability"],
      "properties": {
        "fact_type": {"type": "string", "enum": ["first", "last", "minimum", "maximum", "net_change", "largest_step_down", "largest_step_up", "turning_point", "phase", "data_quality"]},
        "claim_zh": {"type": "string"},
        "value": {"type": "number"},
        "timestamp": {"type": "string"},
        "evidence_index": {"type": "integer"},
        "verifiability": {"type": "string", "enum": ["exact", "derived", "judgment"]}
      }
    },
    "evidencePoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric_id", "timestamp", "index", "value"],
      "properties": {
        "metric_id": {"type": "string"},
        "timestamp": {"type": "string"},
        "index": {"type": "integer"},
        "value": {"type": "number"}
      }
    }
  }
}
