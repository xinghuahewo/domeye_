FLASK_CONFIG=production
SECRET_KEY=change-me-with-a-long-random-value
HOST=127.0.0.1
PORT=28473
DEBUG=false
AUTO_INIT_DB=false
LOAD_CORE_DATA_ON_STARTUP=false

SOURCE=r
INFO_DIR=/home/bgpdata/Domeye-Core/backend/info

DB_HOST=127.0.0.1
DB_PORT=29429
DB_NAME=bgp_project
DB_USER=domeye_core_reader
DB_PASSWORD=change-me

MAIL_ENABLED=false

FEATURE_COUNTRY_TABLE=feature_country
FEATURE_OTHER_TABLE=feature_other
FEATURE_ASN_MONTHLY_ENABLED=true
FEATURE_ASN_OLD_SUFFIX=_old
# 国家中断 Agent Sidecar 只允许配置为本机 HTTP/HTTPS；留空时代理返回 503。
COUNTRY_OUTAGE_AGENT_URL=http://127.0.0.1:28474
# Python 控制面与本机 Sidecar 共用的内部凭据；部署时生成至少 24 字符随机值。
COUNTRY_OUTAGE_AGENT_SHARED_TOKEN=replace-with-a-random-internal-token
# 身份模式默认留空并失败关闭。正式 OIDC/WSGI 接入使用 wsgi_remote_user：
# 受信任本地层须逐请求写入标准 REMOTE_USER 和只存在于 WSGI environ 的
# domeye.country_outage_authorization_scope。
# 当前内部固定历史观测环境可显式使用 internal_fixed_history；它仅接受回环请求，
# 只从下一项读取安全单用户 ID，并由代码固定授予 country_outage_event_read:IR。
# 两种模式均不读取任何 HTTP 身份或权限头；不得用于公网 Flask 入口。
COUNTRY_OUTAGE_AGENT_IDENTITY_MODE=
# 仅 internal_fixed_history 模式读取；示例不是凭据，也不代表真实人员身份。
COUNTRY_OUTAGE_AGENT_INTERNAL_USER_ID=internal-history-observer
