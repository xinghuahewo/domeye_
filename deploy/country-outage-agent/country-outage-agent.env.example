# 安装位置固定为：
# /home/bgpdata/Domeye-Core-runtime/config/country-outage-agent.env
# 目录必须 root:root 0700，文件必须 root:root 0600。脚本按固定键逐项解析，
# 不会 source 本文件。

COUNTRY_OUTAGE_AGENT_URL=http://127.0.0.1:28474
COUNTRY_OUTAGE_AGENT_SHARED_TOKEN=replace-with-at-least-32-random-safe-characters
COUNTRY_OUTAGE_AGENT_IDENTITY_MODE=internal_fixed_history
COUNTRY_OUTAGE_AGENT_INTERNAL_USER_ID=domeye-fixed-history

COUNTRY_OUTAGE_AGENT_NARRATOR=pi-sdk-certified
COUNTRY_OUTAGE_AGENT_HOST=127.0.0.1
COUNTRY_OUTAGE_AGENT_PORT=28474
COUNTRY_OUTAGE_AGENT_REPORT_CACHE_TTL_MS=3600000

# bootstrap 仅用于 prepare 创建 release 内独立 venv，必须是 Python 3.10。
COUNTRY_OUTAGE_AGENT_PYTHON_BOOTSTRAP=/usr/bin/python3
DOMEYE_API_BASE_URL=http://127.0.0.1:28473/api/v2/
DOMEYE_API_TIMEOUT_MS=5000
DOMEYE_REPORT_PYTHON_EXECUTABLE=/home/bgpdata/Domeye-Core-runtime/country-outage-agent/current/pdf-venv/bin/python
DOMEYE_REPORT_FONT_PATH=/opt/domeye/fonts/NotoSansCJKsc-Regular.otf
DOMEYE_REPORT_FONT_SHA256=replace-with-lowercase-font-sha256
DOMEYE_REPORT_PDF_TIMEOUT_MS=45000

COUNTRY_OUTAGE_PI_CERTIFIED_REGISTRY_PATH=/home/bgpdata/Domeye-Core-runtime/country-outage-agent/current/agent-sidecar/resources/certified-models/country-outage-pi-models-v1.json
COUNTRY_OUTAGE_PI_PROFILE=deepseek-v4-flash-pi-0.82.1-v1
COUNTRY_OUTAGE_PI_AUTH_PATH=/home/bgpdata/Domeye-Core-runtime/config/country-outage-pi-auth.json
COUNTRY_OUTAGE_PI_AUDIT_DIRECTORY=/var/log/domeye/country-outage-pi-audit
