# 正式入口固定为已认证 Pi SDK 叙述器，禁止使用 A3 验收身份。
COUNTRY_OUTAGE_AGENT_NARRATOR=pi-sdk-certified
COUNTRY_OUTAGE_AGENT_HOST=127.0.0.1
COUNTRY_OUTAGE_AGENT_PORT=28474

# Python 控制面与 Sidecar 之间的内部 Bearer Token，至少 24 字符。
# 这里只保留占位符；真实值必须由部署时的 Secret 注入。
COUNTRY_OUTAGE_AGENT_SHARED_TOKEN=

# Sidecar 只访问回环 Flask API；不得把 Nginx 公网入口配置为事实 API。
DOMEYE_API_BASE_URL=http://127.0.0.1:28473/api/v2/
# 以下三项如保留，必须与 country-outage-agent-core-acceptance-v3 完全一致；
# 正式入口拒绝任意环境覆盖或静默漂移。
DOMEYE_API_TIMEOUT_MS=5000
DOMEYE_REPORT_PYTHON_EXECUTABLE=/opt/domeye/agent-sidecar/.venv/bin/python
DOMEYE_REPORT_FONT_PATH=/opt/domeye/fonts/NotoSansCJKsc-Regular.otf
DOMEYE_REPORT_PDF_TIMEOUT_MS=45000

# 同一授权范围和同一固定报告服务身份的基础报告短期复用；冻结为 1 小时。
COUNTRY_OUTAGE_AGENT_REPORT_CACHE_TTL_MS=3600000

# 正式模型只允许选择认证注册表中的 profile；默认注册表为空并会失败关闭。
COUNTRY_OUTAGE_PI_CERTIFIED_REGISTRY_PATH=/opt/domeye/agent-sidecar/resources/certified-models/country-outage-pi-models-v1.json
COUNTRY_OUTAGE_PI_PROFILE=

# 必须是 Sidecar 专用的绝对路径、普通文件、当前用户所有且权限不宽于 0600。
# 文件可以是空对象，以便只使用供应方原生环境认证；不要在仓库中填写真实密钥。
COUNTRY_OUTAGE_PI_AUTH_PATH=/run/domeye-secrets/country-outage-pi-auth.json

# 正式 Pi 运行安全审计的专用绝对目录。目录必须由 Sidecar 运行用户所有、
# 为无符号链接的真实路径且权限严格为 0700；Sidecar 不会自动创建目录。
# 记录按 UTC 日写入 0600 JSONL，固定保留当前 UTC 日及前 29 日。
COUNTRY_OUTAGE_PI_AUDIT_DIRECTORY=/var/log/domeye/country-outage-pi-audit

# 当前正式核心入口固定使用 disabled Provider：
# external_evidence=not_configured，不访问网络、不读取外部 URL、不生成外部附录。
# 未来启用外部能力包必须另行配置和验收，不得在本示例中临时增加联网参数。
