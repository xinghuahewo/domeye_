{
  "description": "Domeye Core 阶段任务的条件化最终验收回检。",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/rrc25_global_state_replay_review.py\"",
            "timeout": 10,
            "statusMessage": "回检 RRC25 全局状态重放最终验收要求"
          },
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/p0_data_foundation_r_track_review.py\"",
            "timeout": 20,
            "statusMessage": "按已声明阶段回检 P0 数据基础 R 轨"
          },
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/country_outage_agent_review.py\"",
            "timeout": 20,
            "statusMessage": "按已声明阶段回检国家中断报告 Agent"
          },
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/country_outage_trend_analysis_review.py\"",
            "timeout": 20,
            "statusMessage": "按已声明阶段回检国家中断趋势分析"
          },
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/country_outage_generalization_review.py\"",
            "timeout": 20,
            "statusMessage": "按已声明阶段回检国家中断通用观测页"
          },
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/data_layer_224_310_review.py\"",
            "timeout": 20,
            "statusMessage": "按已声明阶段回检 Domeye 数据层 224-310"
          }
        ]
      }
    ]
  }
}
